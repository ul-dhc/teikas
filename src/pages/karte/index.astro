---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { mapData } from "../../map/data";
import "maplibre-gl/dist/maplibre-gl.css";
import "../../map/style.css";
import "../../styles/exploration.css";
const base = import.meta.env.BASE_URL;
const legendProperties = mapData.legends.features.map((feature) => feature.properties);
const mapYears = [...legendProperties, ...mapData.unmappedLegends].map((properties) => Number(properties.year)).filter(Boolean);
const mapMinYear = Math.min(...mapYears);
const mapMaxYear = Math.max(...mapYears);
const mapUndatedCount = [...legendProperties, ...mapData.unmappedLegends].filter((properties) => !properties.year).length;
const mapUndatedPercent = Math.round((mapUndatedCount / (legendProperties.length + mapData.unmappedLegends.length)) * 100);
---

<BaseLayout title="Karte" active="map">
  <article class="map-page" data-map-page data-base={base} data-undated-count={mapUndatedCount} data-undated-percent={mapUndatedPercent}>
    <div class="map-workspace browser-layout browser">
    <aside class="platform-filter-panel filter-sidebar map-filters" data-map-filters>
      <button class="mobile-filter-toggle" type="button" data-map-mobile-filter-toggle aria-expanded="false" aria-controls="map-filters"><span><i data-lucide="sliders-horizontal"></i><span data-i18n="map.filters">Filtri</span></span><i data-lucide="chevron-down"></i></button>
      <form id="map-filters">
        <div class="filter-title"><h2 data-i18n="map.filters">Filtri</h2><a class="context-help context-help-icon"  href={`${base}par-projektu/#dati`} target="_blank" rel="noopener"><i data-lucide="info"></i><span data-i18n="about.filtersHelp">Par filtriem</span></a><button class="text-button clear-filters" type="button" data-map-filter-clear hidden><i data-lucide="rotate-ccw"></i><span data-i18n="map.clearFiltersLong">Notīrīt filtrus</span></button></div>
        <details class="multi-select" data-map-filter="theme" data-multi-filter="theme"><summary><span data-i18n="map.filterThemes">Tēmas</span><small data-map-filter-count>Alle</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchThemes">Meklēt tēmu…</span><input class="platform-search" type="search" data-map-filter-search placeholder="Søk i ML-kategorier…" data-i18n-placeholder="map.searchThemes"/></label><div class="multi-actions"><button type="button" data-map-select-all data-i18n="map.selectAll">Atzīmēt visus</button><button type="button" data-map-clear-all data-i18n="map.clearAll">Noņemt visus</button></div><div class="multi-options"></div></div></details>
        <details class="multi-select" data-map-filter="narrator" data-multi-filter="narrator"><summary><span data-i18n="map.filterNarrators">Teicēji</span><small data-map-filter-count>Alle</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchNarrators">Meklēt teicēju…</span><input class="platform-search" type="search" data-map-filter-search placeholder="Søk etter informant…" data-i18n-placeholder="map.searchNarrators"/></label><div class="multi-actions"><button type="button" data-map-select-all data-i18n="map.selectAll">Atzīmēt visus</button><button type="button" data-map-clear-all data-i18n="map.clearAll">Noņemt visus</button></div><div class="multi-options"></div></div></details>
        <details class="multi-select" data-map-filter="collector" data-multi-filter="collector"><summary><span data-i18n="map.filterCollectors">Pierakstītāji</span><small data-map-filter-count>Alle</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchCollectors">Meklēt pierakstītāju…</span><input class="platform-search" type="search" data-map-filter-search placeholder="Søk etter samler…" data-i18n-placeholder="map.searchCollectors"/></label><div class="multi-actions"><button type="button" data-map-select-all data-i18n="map.selectAll">Atzīmēt visus</button><button type="button" data-map-clear-all data-i18n="map.clearAll">Noņemt visus</button></div><div class="multi-options"></div></div></details>
        <details class="multi-select" data-map-filter="place" data-multi-filter="place"><summary><span data-i18n="map.filterPlaces">Vietas</span><small data-map-filter-count>Alle</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchPlaces">Meklēt vietu…</span><input class="platform-search" type="search" data-map-filter-search placeholder="Søk etter sted…" data-i18n-placeholder="map.searchPlaces"/></label><div class="multi-actions"><button type="button" data-map-select-all data-i18n="map.selectAll">Atzīmēt visus</button><button type="button" data-map-clear-all data-i18n="map.clearAll">Noņemt visus</button></div><label class="unknown-toggle"><input type="checkbox" data-map-include-unknown="place" checked/><span data-i18n="filters.includeUnknownPlaces">Iekļaut nezināmās vietas</span></label><div class="multi-options"></div></div></details>
        <details class="multi-select" data-map-filter="volume" data-multi-filter="volume"><summary><span data-i18n="map.filterVolumes">Sējumi</span><small data-map-filter-count>Alle</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchVolumes">Meklēt sējumu</span><input class="platform-search" type="search" data-map-filter-search placeholder="Meklēt sējumu…" data-i18n-placeholder="map.searchVolumes"/></label><div class="multi-actions"><button type="button" data-map-select-all data-i18n="map.selectAll">Atzīmēt visus</button><button type="button" data-map-clear-all data-i18n="map.clearAll">Noņemt visus</button></div><div class="multi-options"></div></div></details>
        <details class="multi-select" data-map-filter="translation" data-multi-filter="translation"><summary><span data-i18n="map.filterTranslation">Tulkojums</span><small data-map-filter-count>Alle</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only">Søk</span><input class="platform-search" type="search" data-map-filter-search placeholder="Søk…"/></label><div class="multi-actions"><button type="button" data-map-select-all data-i18n="map.selectAll">Atzīmēt visus</button><button type="button" data-map-clear-all data-i18n="map.clearAll">Noņemt visus</button></div><div class="multi-options"></div></div></details><fieldset class="timeline"><legend data-i18n="map.timeRange">Ieraksta vai avota gads</legend><div class="timeline-values"><output data-map-year-from>{mapMinYear}</output><span>–</span><output data-map-year-to>{mapMaxYear}</output></div><div class="dual-range"><span class="range-track" aria-hidden="true"></span><input type="range" min={mapMinYear} max={mapMaxYear} value={mapMinYear} data-map-year-from-input aria-label="No gada" data-i18n-aria-label="map.yearFrom"/><input type="range" min={mapMinYear} max={mapMaxYear} value={mapMaxYear} data-map-year-to-input aria-label="Līdz gadam" data-i18n-aria-label="map.yearTo"/></div><label class="undated-toggle"><input type="checkbox" data-map-undated checked/><span data-i18n="map.includeUndated">Iekļaut nedatētās teikas</span><small data-map-undated-note></small></label></fieldset>
      </form>
      <details class="download-menu" data-map-download data-disabled="true"><summary aria-disabled="true"><i data-lucide="download"></i><span data-i18n="map.download">Lejupielādēt</span><i data-lucide="chevron-down"></i></summary><div class="download-options"><a class="context-help"  href={`${base}par-projektu/#dati`} target="_blank" rel="noopener"><i data-lucide="info"></i><span data-i18n="about.exportsHelp">Par lejupielādi</span></a><div class="download-formats"><button type="button" data-map-export="csv" disabled>CSV</button><button type="button" data-map-export="geojson" disabled>GeoJSON</button><button type="button" data-map-export="graphml" disabled>GraphML</button></div></div></details><a class="map-alternative-link" href={`${base}teksti/`} data-i18n="map.accessibleAlternative">Izmantojiet tekstu pārlūku kā kartes tekstuālo alternatīvu.</a><p class="download-hint" data-map-download-hint data-i18n="map.downloadHint">Lai lejupielādētu, vispirms veiciet atlasi.</p>
    </aside>
    <button type="button" class="map-filter-collapse" data-map-filter-collapse aria-expanded="true" aria-controls="map-filters" aria-label="Skjul filtre" data-tooltip="Skjul filtre"><i data-lucide="chevron-left"></i></button>
    <section
      class="map-stage"
      aria-label="Kart over sagn"
      data-i18n-aria-label="map.title"
    >
      <div class="corpus-map" data-map tabindex="0"></div>
      <div class="map-toolbar">
        <div class="map-toolbar-primary">
          <div class="map-mode-row">
          <div
            class="map-mode"
            role="group"
            aria-label="Visningstype"
            data-i18n-aria-label="map.visualizationType"
          >
            <button
              type="button"
              data-map-mode="points"
              aria-pressed="true"
              data-i18n="map.modePoints">Teikas</button
            >
            <button type="button" data-map-mode="places" aria-pressed="false" data-i18n="map.modePlaces">Vietas</button>
            <button
              type="button"
              data-map-mode="clusters"
              aria-pressed="false"
              data-i18n="map.modeClusters">Kopas</button
            >
            <button
              type="button"
              data-map-mode="heatmap"
              aria-pressed="false"
              data-i18n="map.modeHeatmap">Intensitāte</button
            >
            <button
              type="button"
              data-map-mode="network"
              aria-pressed="false"
              data-i18n="map.modeNetwork">Tīklojums</button
            >
          </div>
          <button type="button" class="map-network-play" data-network-motion aria-pressed="false" aria-label="Atskaņot tīkla animāciju" data-tooltip="Atskaņot tīkla animāciju" hidden><i data-lucide="play" data-motion-play></i><i data-lucide="pause" data-motion-pause hidden></i></button>
          </div>
          <details class="layer-menu" data-layer-menu>
            <summary
              ><i data-lucide="settings-2"></i><span data-i18n="map.layers"
                >Iestatījumi</span
              ><i data-lucide="chevron-down"></i></summary
            >
            <div class="layer-panel"><a class="context-help" data-map-method href={`${base}par-projektu/#dati`} target="_blank" rel="noopener"><i data-lucide="info"></i><span data-i18n="about.viewHelp">Par šo skatu</span></a>
      <details class="network-toolbar" data-network-toolbar open hidden>
        <summary class="network-settings-toggle"><i data-lucide="settings-2"></i><span data-i18n="map.networkSettings">Tīkla iestatījumi</span><i data-lucide="chevron-down"></i></summary>
        <div class="network-settings-body">
        <div class="network-context-row"><p data-network-context></p><a class="network-info-button" data-network-method href={`${base}par-projektu/#dati`} target="_blank" rel="noopener"><i data-lucide="info"></i><span class="sr-only" data-i18n="map.networkMethodMetadata">Kā veidots šis tīkls?</span></a></div>
        <p data-network-visibility aria-live="polite"></p>
        <label class="network-show-all"><input type="checkbox" data-network-strongest-only /><span data-i18n="map.networkStrongestOnly">Rādīt spēcīgākos 10% katrai vietai</span></label>
        <div class="network-field"><span data-i18n="map.networkType">Tīkla veids</span><details class="network-choice" data-network-choice><summary><span data-network-choice-label data-i18n="map.networkSharedCollectors">Kopīgi pierakstītāji</span><i data-lucide="chevron-down"></i></summary><div><button type="button" data-network-value="collectors" data-i18n="map.networkSharedCollectors">Kopīgi pierakstītāji</button><button type="button" data-network-value="plots" data-i18n="map.networkSharedTypes">Kopīgas nodaļas</button></div><select data-network-type hidden><option value="plots">Felles ML-kategorier</option><option value="collectors" selected>Felles samlere</option></select></details></div>
        <div class="network-field"><span class="network-field-heading"><span data-i18n="map.networkColorBy">Krāsot pēc</span><a class="context-help context-help-icon"  href={`${base}par-projektu/#dati`} target="_blank" rel="noopener"><i data-lucide="info"></i><span data-i18n="about.networkColorsTitle">Tīkla krāsas un izmērs</span></a></span><details class="network-choice" data-network-choice><summary><span data-network-choice-label data-i18n="map.networkColorCollector">Pierakstītājs</span><i data-lucide="chevron-down"></i></summary><div><button type="button" data-network-value="collector" data-i18n="map.networkColorCollector">Pierakstītājs</button><button type="button" data-network-value="theme" data-i18n="map.networkColorTheme">Dominējošās tēmas</button><button type="button" data-network-value="single" data-i18n="map.networkColorSingle">Vienā krāsā</button></div><select data-network-color hidden><option value="collector" selected>Samler</option><option value="theme">Dominerende ML-kategori</option><option value="single">Én farge</option></select></details></div>
        <fieldset class="map-palette" data-network-palette hidden><legend data-i18n="map.dataColor">Datu krāsa</legend><label><input type="radio" name="network-palette" value="yellow" /><span class="map-palette-swatch map-palette-yellow"></span><span data-i18n="map.colorYellow">Dzeltena</span></label><label><input type="radio" name="network-palette" value="blue" /><span class="map-palette-swatch map-palette-blue"></span><span data-i18n="map.colorBlue">Zila</span></label><label><input type="radio" name="network-palette" value="green" /><span class="map-palette-swatch map-palette-green"></span><span data-i18n="map.colorGreen">Zaļa</span></label><label><input type="radio" name="network-palette" value="coral" /><span class="map-palette-swatch map-palette-coral"></span><span data-i18n="map.colorCoral">Koraļļu</span></label></fieldset>
        <div class="network-field"><span data-i18n="map.networkOtherElements">Kad izvēlēta vieta</span><details class="network-choice" data-network-choice><summary><span data-network-choice-label data-i18n="map.networkFadeOthers">Blāvināt pārējos punktus un līnijas</span><i data-lucide="chevron-down"></i></summary><div><button type="button" data-network-value="fade" data-i18n="map.networkFadeOthers">Blāvināt pārējos punktus un līnijas</button><button type="button" data-network-value="hide" data-i18n="map.networkHideOthers">Paslēpt pārējos punktus un līnijas</button></div><select data-network-others hidden><option value="fade" selected>Fade other nodes and threads</option><option value="hide">Hide other nodes and threads</option></select></details></div>
        <div class="network-field"><span data-i18n="map.networkSizeBy">Apļu izmēru nosaka</span><details class="network-choice" data-network-choice><summary><span data-network-choice-label data-i18n="map.networkSizeByLegends">Teiku skaits</span><i data-lucide="chevron-down"></i></summary><div><button type="button" data-network-value="legends" data-i18n="map.networkSizeByLegends">Teiku skaits</button><button type="button" data-network-value="connections" data-i18n="map.networkSizeByConnections">Saikņu skaits</button></div><select data-network-size-by hidden><option value="legends" selected>Antall sagn</option><option value="connections">Antall forbindelser</option></select></details></div>
        <label class="network-thread-control" for="network-bubble-size"><span data-i18n="map.networkBubbleSize">Apļu izmērs</span><span class="network-thread-range"><input id="network-bubble-size" data-network-size type="range" min="25" max="200" step="5" value="60" /><output for="network-bubble-size" data-network-size-output>60%</output></span></label>
        <label class="network-thread-control" for="network-thread-intensity"><span data-i18n="map.networkThreadIntensity">Līniju intensitāte</span><span class="network-thread-range"><input id="network-thread-intensity" data-network-intensity type="range" min="0" max="200" step="5" value="15" /><output for="network-thread-intensity" data-network-intensity-output>15%</output></span></label>
        </div>
      </details>
              <section class="uncertainty-settings" hidden><input type="checkbox" data-show-uncertainty /><div data-uncertainty-key hidden><p></p></div></section>
              <section class="layer-group">
                <h2 data-i18n="map.basemap">Pamatkarte</h2>
                <div class="layer-select">
                  <span data-i18n="map.basemapStyle">Kartes izskats</span>
                  <details class="basemap-select" data-basemap-menu>
                    <summary><span data-basemap-label></span><i data-lucide="chevron-down"></i></summary>
                    <div class="basemap-options" role="radiogroup">
                      <button type="button" role="radio" data-basemap-option="dark" data-i18n="map.basemapOpenDark"><i data-lucide="check"></i>Dark</button>
                      <button type="button" role="radio" data-basemap-option="fiord" data-i18n="map.basemapFiord"><i data-lucide="check"></i>Fiord</button>
                      <button type="button" role="radio" data-basemap-option="positron" data-i18n="map.basemapPositron"><i data-lucide="check"></i>Positron</button>
                      <button type="button" role="radio" data-basemap-option="streets" data-i18n="map.basemapOSM"><i data-lucide="check"></i>OpenStreetMap</button>
                    </div>
                  </details>
                  <input type="hidden" data-basemap-style />
                </div>
                <label class="layer-option"
                  ><input type="checkbox" data-layer="geography" checked /><span
                    class="layer-check"><i data-lucide="check"></i></span
                  ><span data-i18n="map.geography">Ģeogrāfiskais fons</span
                  ></label
                >
                <label class="layer-option"
                  ><input type="checkbox" data-layer="labels" checked /><span
                    class="layer-check"><i data-lucide="check"></i></span
                  ><span data-i18n="map.labels">Vietu nosaukumi</span></label
                >
              </section>
          <a class="map-unlocated-count" data-map-unlocated-count target="_blank" rel="noopener" hidden><i data-lucide="map-pin-off"></i><span></span><i data-lucide="external-link"></i></a>
              <a class="context-help"  href={`${base}par-projektu/#dati`} target="_blank" rel="noopener"><i data-lucide="info"></i><span data-i18n="about.dataHelp">Kāpēc teiku skaits atšķiras?</span></a><section class="layer-group" data-visualization-settings>
                <fieldset class="map-palette" data-map-palette>
                  <legend data-i18n="map.dataColor">Datu krāsa</legend>
                  <label class="map-palette-wide"><input type="radio" name="map-palette" value="spectrum" /><span class="map-palette-swatch map-palette-spectrum"></span><span data-i18n="map.colorSpectrum">Zils–zelta–koraļļu</span></label>
                  <label><input type="radio" name="map-palette" value="green" /><span class="map-palette-swatch map-palette-green"></span><span data-i18n="map.colorGreen">Zaļa</span></label>
                  <label><input type="radio" name="map-palette" value="blue" /><span class="map-palette-swatch map-palette-blue"></span><span data-i18n="map.colorBlue">Zila</span></label>
                  <label><input type="radio" name="map-palette" value="yellow" /><span class="map-palette-swatch map-palette-yellow"></span><span data-i18n="map.colorYellow">Dzeltena</span></label>
                  <label class="map-palette-wide"><input type="radio" name="map-palette" value="coral" /><span class="map-palette-swatch map-palette-coral"></span><span data-i18n="map.colorCoral">Koraļļu</span></label>
                </fieldset>
                <fieldset class="point-color-by" data-places-sizing hidden><legend data-i18n="map.networkSizeBy">Apļu izmēru nosaka</legend><label><input type="radio" name="places-size-by" value="legends" checked /><span data-i18n="map.networkSizeByLegends">Teiku skaits</span></label><label><input type="radio" name="places-size-by" value="uniform" /><span data-i18n="map.uniformSize">Vienāds izmērs</span></label></fieldset>
                <fieldset class="point-color-by" data-point-color-by data-point-layer-control>
                  <legend data-i18n="map.colorBy">Krāsot pēc</legend>
                  <label><input type="radio" name="point-color-by" value="single" /><span data-i18n="map.colorBySingle">Vienā krāsā</span></label>
                  <label><input type="radio" name="point-color-by" value="theme" checked /><span data-i18n="map.colorByTheme">Tēmas</span></label>
                  <label><input type="radio" name="point-color-by" value="narrator" /><span data-i18n="map.colorByNarrator">Teicēja</span></label>
                  <label><input type="radio" name="point-color-by" value="collector" /><span data-i18n="map.colorByCollector">Pierakstītāja</span></label>
                </fieldset>
                <fieldset class="point-style-choice" data-point-style-choice data-point-layer-control>
                  <legend data-i18n="map.pointStyle">Punktu attēlojums</legend>
                  <label><input type="radio" name="point-style" value="rays" /><span data-i18n="map.pointStyleRays">Stari</span></label>
                  <label><input type="radio" name="point-style" value="bubbles" /><span data-i18n="map.pointStyleBubbles">Burbuļi</span></label>
                </fieldset>
      <div class="point-controls point-settings-controls" data-point-controls>
        <label data-places-size-control hidden><span data-i18n="map.networkBubbleSize">Apļu izmērs</span><input type="range" min="15" max="200" step="5" value="100" data-places-size aria-label="Boblestørrelse" /><output data-places-size-output>100%</output></label>
        <label><span data-i18n="map.pointIntensity">Krāsu intensitāte</span><input type="range" min="20" max="200" step="5" value="60" data-point-intensity /><output data-point-intensity-output>60%</output></label>
      </div>
                <label class="layer-option" data-unmapped-control
                  ><input type="checkbox" data-layer="unmapped" /><span
                    class="layer-check"><i data-lucide="check"></i></span
                  ><span data-i18n="map.showUnmapped"
                    >Rādīt teikas bez koordinātām</span
                  ></label
                >
              </section>
            </div>
          </details>
        </div>
        <div class="map-count-group">
        <a class="map-count" data-map-count aria-live="polite" target="_blank" rel="noopener"><span data-map-count-text></span><i data-lucide="external-link"></i></a>
        </div>
      </div>

      <div class="heat-controls" data-heat-controls hidden>
        <label
          ><span data-i18n="map.intensity">Intensitāte</span><input
            type="range"
            min="40"
            max="200"
            value="100"
            step="10"
            data-heat-intensity
          /><output data-heat-output>100%</output></label
        >
        <label
          ><span data-i18n="map.radius">Aptvērums</span><input
            type="range"
            min="8"
            max="48"
            value="14"
            step="2"
            data-heat-radius
          /><output data-radius-output>14</output></label
        >
        <div class="heat-key" data-heat-key hidden>
          <span data-i18n="map.heatLow">Zems</span><span class="heat-ramp"></span><span data-i18n="map.heatMedium">Vidējs</span><span data-i18n="map.heatHigh">Augsts</span>
        </div>
      </div>
      <div class="network-view-title" data-network-view-title hidden><div class="network-title-label"><i data-lucide="network"></i><span data-network-title-text data-i18n="map.networkTitleCollectors">Kopīgu pierakstītāju tīkls</span></div><div class="network-active-filters" data-network-active-filters hidden></div></div>
      <aside class="map-panel" data-map-panel aria-live="polite" hidden></aside>
      <div class="map-empty-state" data-map-empty-state hidden><strong data-i18n="map.emptyTitle">Šai atlasei nav atrasta neviena teika.</strong><button type="button" data-map-empty-clear data-i18n="map.clearFiltersLong">Notīrīt filtrus</button></div>
      <div class="map-legend" data-map-legend>
        <strong class="map-legend-title" data-i18n="map.legendTitle">Apzīmējumi</strong>

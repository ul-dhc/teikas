---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {types,topics,metadataLabels} from '../../network/data';
import {types as overviewTypes, topics as overviewTopics} from '../../ml-index/data';
const base=import.meta.env.BASE_URL;
const payload=JSON.stringify({types,topics,metadataLabels,base}).replace(/</g,'\\u003c');
---
<BaseLayout title="Dati" active="data" description="Teiku krājuma pārskats un saistību tīkls: personas, vietas, tēmas un sējumi.">
  <div class="ml-page ml-data-page shell" data-i18n-skip>
    <header class="ml-hero"><h1 data-network-page-title>Dati</h1><div id="ml-title-filters"></div></header>
    <nav class="data-overview-tabs" aria-label="Datu skati">
      <a href={`${base}dati/#overview`} data-data-view="overview"><i data-lucide="chart-no-axes-column"></i><span data-overview-tab>Pārskats</span></a>
      <a href={`${base}dati/#network`} data-data-view="network"><i data-lucide="network"></i><span data-network-tab>Tīkls</span></a>
    </nav>
    <section id="ml-dashboard" aria-labelledby="ml-dashboard-title"><div id="ml-dashboard-content"></div></section>
    <div class="data-help-footer"><a class="context-help" href={`${base}par-projektu/#tikls`} target="_blank" rel="noopener"><i data-lucide="info"></i><span data-network-guide>Palīdzība tīkla izpētei</span></a></div>
    <noscript><p>Tīkla izpētei nepieciešams JavaScript.</p></noscript>
  </div>
  <script type="application/json" id="ml-data" is:inline set:html={payload}/>
  <script type="application/json" id="overview-data" is:inline set:html={JSON.stringify({types:overviewTypes,topics:overviewTopics,base}).replace(/</g,'\\u003c')}/>
  <script>
    import '../../scripts/data-page';
    const updateHeading=()=>{const lang=document.documentElement.dataset.uiLang;document.querySelector('[data-network-page-title]')!.textContent=lang==='de'?'Daten':lang==='en'?'Data':'Dati'};
    const updateGuide=()=>{const lang=document.documentElement.dataset.uiLang;document.querySelector('[data-network-guide]')!.textContent=lang==='de'?'Hilfe zur Datenerkundung':lang==='en'?'Data exploration guide':'Palīdzība datu izpētei'};
    const guideLink=document.querySelector<HTMLAnchorElement>('.context-help')!;
    if(location.hash!=='#network')guideLink.href=guideLink.href.replace('#tikls','#dati');
    updateGuide();window.addEventListener('ui-language-change',updateGuide);
    updateHeading();window.addEventListener('ui-language-change',updateHeading);
  </script>
</BaseLayout>



<style is:global>
.ml-data-page .ml-hero{display:flex;align-items:center;flex-wrap:wrap;gap:.65rem 1rem;margin-bottom:1rem}
.ml-data-page .ml-hero h1{margin:0}
</style>

<style is:global>
.ml-data-page:has(#ml-dashboard){padding-top:.8rem}
.ml-data-page .ml-hero{margin-bottom:.65rem!important}
.ml-data-page .ml-hero h1{font-size:1.75rem!important;line-height:1.15;margin:0!important}
.ml-data-page .data-overview-tabs{display:flex;width:fit-content;border:1px solid var(--line);margin:0 0 .45rem;padding:3px;gap:3px;background:var(--paper);border-color:color-mix(in srgb,var(--blue) 45%,var(--line));border-radius:var(--radius)}
.ml-data-page .data-overview-tabs a{display:inline-flex;align-items:center;text-decoration:none;justify-content:center;min-height:40px;min-width:120px;padding:.5rem 1rem;gap:.5rem;font-size:.85rem;font-weight:600;line-height:1.25;color:var(--blue);border-radius:calc(var(--radius) - 4px)}
.ml-data-page .data-overview-tabs a:hover{background:color-mix(in srgb,var(--blue) 12%,var(--paper))}
.ml-data-page .data-overview-tabs a[aria-current=page]{background:var(--blue);color:var(--paper)}
.ml-data-page .data-overview-tabs svg{width:1rem;height:1rem}
.ml-data-page .ml-data-view-switch{display:none}
.ml-data-page .ml-research-intro{position:static}
.ml-data-page .ml-research-heading{display:flex;flex-direction:row;align-items:center;flex-wrap:wrap;gap:.45rem 1.5rem;margin-bottom:.85rem}
.ml-data-page .ml-research-heading p{font-size:.75rem;line-height:1.5;margin:0;max-width:680px}
.ml-data-page .ml-research-actions{margin-left:auto}
.ml-data-page .data-help-footer{display:flex;justify-content:flex-end;margin-top:1rem;padding-top:.75rem;border-top:1px solid var(--line)}
.ml-data-page .data-help-footer .context-help{font-size:.75rem;color:var(--muted)}
@media(max-width:600px){
.ml-data-page .data-overview-tabs{width:100%}
.ml-data-page .data-overview-tabs a{flex:1;min-width:0}
.ml-data-page .ml-research-actions{width:100%;margin-left:0;justify-content:flex-start}
}
</style>

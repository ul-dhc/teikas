---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { browsePersons } from '../../lib/data';
const base = import.meta.env.BASE_URL;
const types = [...new Set(browsePersons.map(r=>r.type).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'lv'));
const counts = browsePersons.map(r=>Number(r.legendcount)).filter(Boolean); const minCount=Math.min(...counts), maxCount=Math.max(...counts);
/* const narratorpeople = [...new Set(browseRecords.map(r=>r.narrator).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'lv'));
const collectorPeople = [...new Set(browseRecords.map(r=>r.collector).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'lv')); */
const unknownPersonValue = '__unknown__';
---
<BaseLayout title="Personu pārlūks" active="persons">
  <header class="browse-hero compact"><div class="shell"><a class="back-link icon-link" href={base}><i data-lucide="arrow-left"></i> Atpakaļ</a><h1>Personu pārlūks</h1><p class="lede">Meklējiet, salīdziniet un piespraudiet personas, pie kurām vēlaties atgriezties.</p></div></header>
  <section class="shell browser-layout browser-layout-person browser browser-person" data-browser>
    <aside class="filter-sidebar"><button class="mobile-filter-toggle" type="button" data-mobile-filter-toggle aria-expanded="false" aria-controls="browse-filters"><span><i data-lucide="sliders-horizontal"></i> Filtri</span><i data-lucide="chevron-down"></i></button><form data-controls id="browse-filters"><div class="filter-title"><h2>Filtri</h2><button class="text-button clear-filters" type="button" data-clear hidden><i data-lucide="rotate-ccw"></i> Notīrīt filtrus</button></div>
      <details class="multi-select" data-multi-filter="gender"><summary><span>Dzimumi</span><small data-filter-count="gender">Visi </small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchGenders">Meklēt dzimumu</span><input type="search" placeholder="Meklēt dzimumu…" data-i18n-placeholder="map.searchGenders" data-filter-search="gender" /></label><div class="multi-actions"><button type="button" data-filter-select-all data-i18n="map.selectAll">Atzīmēt visus</button><button type="button" data-filter-clear-all data-i18n="map.clearAll">Noņemt visus</button></div><div class="multi-options" data-filter-options="gender"><label data-option={unknownPersonValue}><input type="checkbox" value={unknownPersonValue} checked /> <span data-i18n="map.unknownPerson">X</span></label><label data-option=M data-i18n="meta.genderM"><input type="checkbox" value=M checked /> <span></span></label><label data-option=F data-i18n="meta.genderF"><input type="checkbox" value=F checked /> <span></span></label></div></div></details>
      <details class="multi-select" data-multi-filter="type"><summary><span>Tips</span><small data-filter-count="type">Visi </small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-i18n="map.searchTypes">Meklēt tipu</span><input type="search" placeholder="Meklēt tipu…" data-i18n-placeholder="map.searchTypes" data-filter-search="type" /></label><div class="multi-actions"><button type="button" data-filter-select-all data-i18n="map.selectAll">Atzīmēt visus</button><button type="button" data-filter-clear-all data-i18n="map.clearAll">Noņemt visus</button></div><div class="multi-options" data-filter-options="type">{types.map(t=><label data-option={t}><input type="checkbox" value={t} checked /> <span>{t}</span></label>)}</div></div></details>
      <fieldset class="timeline"><legend>Teiku skaits </legend><div class="count-values"><output data-count-from>{minCount}</output><span>–</span><output data-count-to>{maxCount}</output></div><div class="dual-range"><span class="range-track" aria-hidden="true"></span><input id="count-from" type="range" min={minCount} max={maxCount} value={minCount}/><input id="count-to" type="range" min={minCount} max={maxCount} value={maxCount}/></div></fieldset>
    </form></aside>
    <button class="browse-filter-collapse" type="button" data-filter-collapse aria-expanded="true" aria-controls="browse-filters" aria-label="Sakļaut filtrus" title="Sakļaut filtrus"><i class="filter-collapse-icon" data-lucide="sliders-horizontal" aria-hidden="true"></i><span data-filter-collapse-label>Sakļaut filtrus</span><i class="filter-collapse-chevron" data-lucide="chevron-left" aria-hidden="true"></i></button>
    <div class="browser-main"><div class="browser-top"><div class="field search-field"><label class="sr-only" for="q">Meklēt</label><input id="q" name="q" type="search" autocomplete="off" placeholder="Meklēt personu…" aria-describedby="search-help" /><small class="search-help" id="search-help" hidden>Frāzes pēdiņās meklē precīzā vārdu secībā. Piemēram: "Reiz bija" "septiņi gadi".</small></div></div>
      <div class="active-filters" data-active-filters hidden aria-label="Aktīvie filtri"></div><div class="browser-toolbar"><div class="result-summary"><span data-result-count-label>20 no <span data-count>{browsePersons.length.toLocaleString('lv-LV')}</span> rezultātiem</span><span class="page-label" data-page-label></span><button class="clear-pins" type="button" data-clear-pins hidden><i data-lucide="pin-off"></i> Noņemt piespraudes</button></div><div class="view-tools"><div class="card-sort" hidden><span>Kārtot</span> <select class="sr-only" data-card-sort tabindex="-1" aria-hidden="true"><option value="random">Nejaušā secībā</option><option value="fullname">Pēc vārda</option><option value="id">Pēc ID</option><option value="gender">Pēc dzimuma</option><option value="type">Pēc tipa</option><option value="legendcount">Pēc teiku skaita</option></select><details class="sort-menu" data-sort-menu><summary><span data-sort-label>Nejaušā secībā</span><i data-lucide="chevron-down"></i></summary><div class="sort-menu-options"><button type="button" data-sort-value="random" aria-pressed="true"><i data-lucide="check"></i><span>Nejaušā secībā</span></button><button type="button" data-sort-value="fullname" aria-pressed="false"><i data-lucide="check"></i><span>Pēc vārda</span></button><button type="button" data-sort-value="gender" aria-pressed="false"><i data-lucide="check"></i><span>Pēc dzimuma</span></button><button type="button" data-sort-value="type" aria-pressed="false"><i data-lucide="check"></i><span>Pēc tipa</span></button><button type="button" data-sort-value="fullname" aria-pressed="false"><i data-lucide="check"></i><span>Pēc teiku skaita</span></button></div></details></div></div></div>
      <div class="list-head list-head-person" data-list-head><button data-column-sort="id">ID <i data-lucide="arrow-up-down"></i></button><button data-column-sort="fullname">Pilnais vārds <i data-lucide="arrow-up-down"></i></button><button data-column-sort="gender">Dzimums <i data-lucide="arrow-up-down"></i></button><button data-column-sort="type">Tips <i data-lucide="arrow-up-down"></i></button><button data-column-sort="legendcount">Teiku skaits <i data-lucide="arrow-up-down"></i></button><span>Piezīmes</span></div>
      <ol class="results-list" data-results></ol><div class="empty" data-empty hidden><strong>Nekas netika atrasts.</strong><br/>Mainiet meklējamo vārdu vai filtrus.</div><div class="pagination-row"><nav class="pagination" aria-label="Rezultātu lapas" data-pagination></nav><label class="page-jump">Doties uz <input type="number" min="1" inputmode="numeric" placeholder="lpp." data-page-jump /></label><div class="page-size"><span data-i18n="browser.perPage">Rādīt lappusē</span><details class="page-size-menu" data-page-size-menu><summary><span data-page-size-label>20</span><i data-lucide="chevron-down"></i></summary><div class="page-size-options"><button type="button" data-page-size="20" aria-pressed="true"><i data-lucide="check"></i><span>20</span></button><button type="button" data-page-size="50" aria-pressed="false"><i data-lucide="check"></i><span>50</span></button><button type="button" data-page-size="100" aria-pressed="false"><i data-lucide="check"></i><span>100</span></button></div></details></div></div>
    </div>
  </section>
  <script type="application/json" id="browse-data" is:inline set:html={JSON.stringify(browsePersons).replace(/</g,'\\u003c')} />
  <script>
    type R={id:string;fullname:string;gender:string;type:string;legendcount:string;notes:string};
    const root=document.querySelector<HTMLElement>('[data-browser]')!,data=JSON.parse(document.querySelector('#browse-data')!.textContent||'[]') as R[];
    const q=root.querySelector<HTMLInputElement>('#q')!,searchHelp=root.querySelector<HTMLElement>('#search-help')!,countFrom=root.querySelector<HTMLInputElement>('#count-from')!,countTo=root.querySelector<HTMLInputElement>('#count-to')!,includeUndated=root.querySelector<HTMLInputElement>('#include-undated')!,timeline=countFrom.closest<HTMLElement>('.timeline')!;
    const list=root.querySelector<HTMLOListElement>('[data-results]')!,count=root.querySelector<HTMLElement>('[data-count]')!,empty=root.querySelector<HTMLElement>('[data-empty]')!,pages=root.querySelector<HTMLElement>('[data-pagination]')!,pageLabel=root.querySelector<HTMLElement>('[data-page-label]')!,listHead=root.querySelector<HTMLElement>('[data-list-head]')!,cardSort=root.querySelector<HTMLSelectElement>('[data-card-sort]')!,cardSortWrap=cardSort.closest<HTMLElement>('.card-sort')!,activeFilters=root.querySelector<HTMLElement>('[data-active-filters]')!,clearButton=root.querySelector<HTMLButtonElement>('[data-clear]')!,clearPinsButton=root.querySelector<HTMLButtonElement>('[data-clear-pins]')!,mobileFilterToggle=root.querySelector<HTMLButtonElement>('[data-mobile-filter-toggle]')!,filterSidebar=root.querySelector<HTMLElement>('.filter-sidebar')!,filterCollapse=root.querySelector<HTMLButtonElement>('[data-filter-collapse]')!;root.querySelector<HTMLElement>('.pagination-row')!.prepend(pageLabel);
    const openPinsButton=document.createElement('button');openPinsButton.type='button';openPinsButton.className='clear-pins open-pins';openPinsButton.innerHTML='<i data-lucide="external-link"></i><span></span>';clearPinsButton.insertAdjacentElement('afterend',openPinsButton);
    const copySelectionButton=document.createElement('button');copySelectionButton.type='button';copySelectionButton.className='clear-pins copy-selection-link';copySelectionButton.innerHTML='<i data-lucide="link"></i><span></span>';openPinsButton.insertAdjacentElement('afterend',copySelectionButton);    const downloadMenu=document.createElement('details');downloadMenu.className='download-menu';downloadMenu.innerHTML='<summary><i data-lucide="download"></i><span></span><i data-lucide="chevron-down"></i></summary><div class="download-options"><fieldset class="download-citation"><legend></legend><label><input type="radio" name="download-citation" value="clarin" checked><span>CLARIN-LV</span></label><label><input type="radio" name="download-citation" value="site"><span>Teikas</span></label></fieldset><div class="download-formats"><button type="button" data-download-format="csv">CSV</button><button type="button" data-download-format="txt">TXT</button><button type="button" data-download-format="json">JSON</button></div></div>';filterSidebar.append(downloadMenu);const downloadHint=document.createElement('p');downloadHint.className='download-hint';downloadMenu.insertAdjacentElement('afterend',downloadHint);
    type SearchText={lv:string;de:string};type MultiType='fullname'|'gender'|'type';const unknownPerson='__unknown__',selectedGenders=new Set<string>(),selectedTypes=new Set<string>(),selectedFullnames=new Set<string>(),selections:Record<MultiType,Set<string>>={gender:selectedGenders,type:selectedTypes,fullname:selectedFullnames},explicitSelections=new Set<MultiType>(),pins=new Set<string>(JSON.parse(localStorage.getItem('teikas-pins')||'[]')),expandedIds=new Set<string>(),seed=Math.random();let page=1,size=20,view=localStorage.getItem('teikas-browse-view')||'list',sortKey='random',sortDirection=1,searchIndex:Map<string,SearchText>|null=null,token=0,activeTerms:string[]=[],activeTermLabels:string[]=[];
    // const initialPlaceId=new URLSearchParams(location.search).get('place'),initialPlace=initialPlaceId?data.find(record=>record.placeId===initialPlaceId)?.place:'';if(initialPlace){selectedPlaces.add(initialPlace);explicitSelections.add('place')}
    const tr=(key:string,values:Record<string,string|number>={})=>(window as any).teikasT?.(key,values)||key;let filterCollapsePreference=localStorage.getItem('teikas-browse-filters-collapsed');const filterLayoutQuery=matchMedia('(min-width:851px)');function applyFilterCollapse(currentView=view){const collapsed=filterLayoutQuery.matches&&(filterCollapsePreference===null?currentView==='grid':filterCollapsePreference==='true');root.classList.toggle('filters-collapsed',collapsed);filterCollapse.setAttribute('aria-expanded',String(!collapsed));const label=tr(collapsed?'map.expandFilters':'map.collapseFilters');filterCollapse.setAttribute('aria-label',label);filterCollapse.title=label}filterCollapse.addEventListener('click',()=>{const collapsed=!root.classList.contains('filters-collapsed');filterCollapsePreference=String(collapsed);localStorage.setItem('teikas-browse-filters-collapsed',filterCollapsePreference);applyFilterCollapse()});filterLayoutQuery.addEventListener('change',()=>applyFilterCollapse());window.addEventListener('ui-language-change',()=>applyFilterCollapse());const syncDownloadAvailability=(resultCount:number)=>{const available=resultCount>0&&resultCount<data.length;downloadMenu.dataset.disabled=String(!available);downloadMenu.querySelector('summary')!.setAttribute('aria-disabled',String(!available));downloadMenu.querySelectorAll<HTMLButtonElement>('[data-download-format]').forEach(button=>button.disabled=!available);downloadHint.hidden=available;downloadHint.textContent=tr('browser.downloadHint');if(!available)downloadMenu.open=false};downloadMenu.querySelector('summary')!.addEventListener('click',event=>{if(downloadMenu.dataset.disabled==='true')event.preventDefault()});new MutationObserver(()=>syncDownloadAvailability(Number((count.textContent||'').replace(/\D/g,''))||0)).observe(count,{childList:true,characterData:true,subtree:true});window.addEventListener('ui-language-change',()=>{downloadHint.textContent=tr('browser.downloadHint')});
    const resultCountLabel=root.querySelector<HTMLElement>('[data-result-count-label]')!;const syncResultCountLabel=()=>{const nodes=resultCountLabel.childNodes;nodes[0].textContent=`${list.children.length} ${tr('browser.resultsOf')} `;nodes[nodes.length-1].textContent=` ${tr('browser.resultsNoun')}`};new MutationObserver(syncResultCountLabel).observe(list,{childList:true});window.addEventListener('ui-language-change',()=>{syncResultCountLabel();list.querySelectorAll<HTMLElement>('.open-new span').forEach(label=>label.textContent=tr('browser.openNewWindow'))});
    const esc=(s:string)=>s.toString().replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]!)),fold=(s:string)=>s.toLocaleLowerCase('lv').normalize('NFD').replace(/[\u0300-\u036f]/g,''),searchNorm=(s:string)=>fold(s).replace(/\s+/g,' ').trim(),parseRawTerms=(value:string)=>{const terms:string[]=[];for(const match of value.matchAll(/"([^"]+)"|“([^”]+)”|(\S+)/g)){const term=(match[1]||match[2]||match[3]||'').replace(/\s+/g,' ').trim();if(term&&!terms.some(item=>searchNorm(item)===searchNorm(term)))terms.push(term)}return terms};const mode=()=>document.documentElement.dataset.contentMode||'parallel';const hash=(s:string)=>{let h=2166136261;for(const c of s)h=Math.imul(h^c.charCodeAt(0),16777619);return(h>>>0)/4294967296};
    const base=import.meta.env.BASE_URL;
    const selectionParams=new URLSearchParams(location.search),sharedSelection=new Set((selectionParams.get('selection')||'').split(',').map(id=>id.trim()).filter(Boolean)),selectionOnly=sharedSelection.size>0,pinnedOnly=selectionParams.get('pinned')==='1';
    async function ensureSearch(){if(searchIndex)return searchIndex;const rows=await(await fetch(`${base}search-index.json?v=2`)).json() as ({id:string}&SearchText)[];return searchIndex=new Map(rows.map(r=>[r.id,{lv:r.lv||'',de:r.de||''}]))}
    function gender(str:string){return str==='M'?`${tr("meta.genderM")}`:str==='F'?`${tr("meta.genderF")}`:""}
    function type(str:string){return str==='Pierakstītājs'?`${tr("map.filterType.collector")}`:`${tr("map.filterType.narrator")}`}
    function marked(value:string,terms:string[]){if(!terms.length)return esc(value);let normalized='',starts:number[]=[],ends:number[]=[];for(let i=0;i<value.length;){const char=String.fromCodePoint(value.codePointAt(i)!),next=i+char.length,part=fold(char);for(const unit of part){normalized+=unit;starts.push(i);ends.push(next)}i=next}const ranges:[number,number][]=[];for(const term of terms){let from=0,at=-1;while((at=normalized.indexOf(term,from))>=0){ranges.push([starts[at],ends[at+term.length-1]]);from=at+Math.max(1,term.length)}}if(!ranges.length)return esc(value);ranges.sort((a,b)=>a[0]-b[0]);const merged=ranges.reduce<[number,number][]>((all,range)=>{const last=all.at(-1);if(last&&range[0]<=last[1])last[1]=Math.max(last[1],range[1]);else all.push([...range]);return all},[]);let html='',cursor=0;for(const [start,end] of merged){html+=esc(value.slice(cursor,start))+`<mark>${esc(value.slice(start,end))}</mark>`;cursor=end}return html+esc(value.slice(cursor))}function contextual(value:string,terms:string[],fallback:string,expanded=false,limitOverride?:number){const clean=(value||fallback).replace(/\s+/g,' ').trim(),limit=limitOverride??(expanded?900:260),folded=fold(clean),term=terms.find(item=>folded.includes(item))||'';if(!term)return clean.slice(0,limit)+(clean.length>limit?'…':'');const at=folded.indexOf(term),before=Math.min(expanded?260:90,Math.round(limit*.38)),after=Math.max(50,limit-before-term.length);let start=Math.max(0,at-before),end=Math.min(clean.length,at+term.length+after);if(start){const space=clean.indexOf(' ',start);start=space<0?start:space+1}if(end<clean.length){const space=clean.lastIndexOf(' ',end);end=space<0?end:space}return`${start?'…':''}${clean.slice(start,end)}${end<clean.length?'…':''}`}
    function item(r:R){const pinned=pins.has(r.id),expanded=expandedIds.has(r.id),href=`${base}teksti/${r.id}/`,personMeta=(label:string,value:string)=>value?`<span class="person-meta"><span class="meta-label">${label}:</span> <span class="meta-value">${marked(value.replace(/[.\s]+$/,''),activeTerms)}.</span></span>`:'',parallel=mode()==='parallel';return `<li class="result-card${pinned?' is-pinned':''}${expanded?' is-expanded':''}" data-id="${r.id}" data-href="${href}" tabindex="0" aria-expanded="${expanded}" aria-label="${tr(expanded?'browser.collapse':'browser.expand')}: ${esc(r.fullname||r.id)}"><button class="pin-button" data-pin="${r.id}" aria-pressed="${pinned}" aria-label="${tr(pinned?'browser.unpin':'browser.pin')}"><i data-lucide="pin"></i></button><div class="result-id">${marked(r.id,activeTerms)}</div><h2>${r.fullname}</h2><div class="result-gender${r.gender?'':' is-empty'}">${marked(gender(r.gender)||'—',activeTerms)}</div><div class="result-type${r.type?'':' is-empty'}">${marked(type(r.type)||'—',activeTerms)}</div><div class="result-legendcount${r.legendcount?'':' is-empty'}">${marked(r.legendcount||'—',activeTerms)}</div><div class="result-notes${r.notes?'':' is-empty'}">${marked(r.notes||'—',activeTerms)}</div></li>`}
    function sortValue(r:R){if(sortKey==='id')return r.id;if(sortKey==='fullname')return r.fullname;if(sortKey==='gender')return r.gender;if(sortKey==='type')return r.type; if(sortKey.startsWith('legendcount'))return r.legendcount;return hash(r.id+seed)}
    function refreshIcons(){(window as any).renderLucideIcons?.()}
    function textMatches(r:R,terms:string[],index:Map<string,SearchText>|null){if(!terms.length)return true;const text=index?.get(r.id),common=[r.id,r.fullname,r.gender,r.type,r.legendcount].join(' '),languageText=mode()==='lv',haystack=searchNorm(`${common} ${languageText}`);return terms.every(term=>haystack.includes(term))}
    function filterValue(r:R,type:MultiType){return r[type]} function selected(type:MultiType,value:string){return!explicitSelections.has(type)||selections[type].has(value||unknownPerson)}function baseMatches(r:R,skip:MultiType|''=''){return(!selectionOnly||sharedSelection.has(r.id))&&(!pinnedOnly||pins.has(r.id))&&(skip==='gender'||selected('gender',r.gender))&&(skip==='type'||selected('type',r.type))&&(r.legendcount?(Number(r.legendcount)>=Number(countFrom.value)&&Number(r.legendcount)<=Number(countTo.value)):false)}

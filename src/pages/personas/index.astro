---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {browsePersons,browseRecords} from '../../lib/data';
import {buildProfiles} from '../../persons/model.js';
import '../../styles/persons.css';
const base=import.meta.env.BASE_URL;
const profiles=buildProfiles(browsePersons,browseRecords);
const records=browseRecords.map(({id,chapterLv,chapterDe,placeId,place})=>({id,chapterLv,chapterDe,placeId,place}));
const sortCriteria=[['random','randomOrder'],['name','sortName'],['count','sortCount'],['role','sortRole'],['gender','sortGender']];
const sortOptions=[['random','randomOrder'],['name','byName'],['name-desc','byNameDesc'],['count','byCount'],['count-asc','byCountAsc'],['role','byRole'],['role-desc','byRoleDesc'],['gender','byGender'],['gender-desc','byGenderDesc']];
---
<BaseLayout title="Teicēji un pierakstītāji" active="persons">
 <div class="people-page" data-people data-i18n-skip>
  <header class="browse-hero compact"><div class="shell">
   <a class="back-link icon-link" href={base}><i data-lucide="arrow-left" aria-hidden="true"></i> <span data-copy="back">Atpakaļ</span></a>
   <h1 data-copy="title">Teicēji un pierakstītāji</h1>
   <p class="lede" data-copy="intro">Iepazīstiet cilvēkus, kuri stāstījuši un pierakstījuši šajā krājumā publicētās teikas. Atrodiet viņu tekstus un izpētiet saistītās tēmas, vietas un cilvēkus.</p>
  </div></header>
  <section class="shell browser-layout browser people-workspace" data-view="list" aria-label="Personu atlase">
   <aside class="platform-filter-panel filter-sidebar">
    <button class="browse-filter-collapse" type="button" data-person-filter-collapse aria-expanded="true" aria-controls="people-filter-body"><i class="filter-collapse-icon" data-lucide="sliders-horizontal" aria-hidden="true"></i><span data-filter-collapse-label>Filtri</span><i class="filter-collapse-chevron" data-lucide="chevron-left" aria-hidden="true"></i></button>
    <button class="mobile-filter-toggle" type="button" data-filter-toggle aria-expanded="false" aria-controls="people-filter-body"><i data-lucide="sliders-horizontal" aria-hidden="true"></i><span data-copy="filters">Tēmas, vietas un papildu atlase</span><i data-lucide="chevron-down" aria-hidden="true"></i></button>
    <div id="people-filter-body"><form class="people-filter-form">
     <div class="filter-title"><h2 data-copy="filtersTitle">Filtri</h2><button class="text-button clear-filters" type="button" data-reset hidden><i data-lucide="rotate-ccw" aria-hidden="true"></i><span data-copy="reset">Notīrīt filtrus</span></button></div>
     <details class="multi-select" data-person-filter="theme"><summary><span data-copy="theme">Tēma</span><small data-person-filter-label="theme"></small><i data-lucide="chevron-down" aria-hidden="true"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-person-filter-search-label="theme"></span><input type="search" autocomplete="off" data-person-filter-search="theme" /></label><div class="multi-options" data-person-filter-options="theme"></div></div><select hidden aria-hidden="true" tabindex="-1" data-theme-filter></select></details>
     <details class="multi-select" data-person-filter="place"><summary><span data-copy="place">Vietas</span><small data-person-filter-label="place"></small><i data-lucide="chevron-down" aria-hidden="true"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-person-filter-search-label="place"></span><input type="search" autocomplete="off" data-person-filter-search="place" /></label><div class="multi-options" data-person-filter-options="place"></div></div><select hidden aria-hidden="true" tabindex="-1" data-place-filter></select></details>
     <details class="multi-select" data-person-filter="gender"><summary><span data-copy="gender">Dzimums</span><small data-person-filter-label="gender"></small><i data-lucide="chevron-down" aria-hidden="true"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only" data-person-filter-search-label="gender"></span><input type="search" autocomplete="off" data-person-filter-search="gender" /></label><div class="multi-options" data-person-filter-options="gender"></div></div><select hidden aria-hidden="true" tabindex="-1" data-gender><option value="" data-copy="all">Visi</option><option value="F" data-copy="female">Sieviete</option><option value="M" data-copy="male">Vīrietis</option><option value="unknown" data-copy="unknown">Nav norādīts</option></select></details>
     <details class="multi-select"><summary><span data-copy="minimum">Teiku skaits</span><small data-minimum-output>Visi</small><i data-lucide="chevron-down" aria-hidden="true"></i></summary><div class="multi-panel"><fieldset class="timeline"><legend class="sr-only" data-copy="minimum">Teiku skaits</legend><div class="dual-range" style="--range-left:0%;--range-right:0%"><span class="range-track" aria-hidden="true"></span><input type="range" min="1" max={Math.max(...profiles.map((person:{ids:string[]})=>person.ids.length))} step="1" value="1" data-minimum aria-label="Teiku skaits" aria-describedby="person-minimum-help" /></div><p class="search-help" id="person-minimum-help" data-minimum-help>Rādīt personas ar vismaz 1 saistīto teiku.</p></fieldset></div></details>
     <label class="undated-toggle" data-saved-only-filter hidden><input type="checkbox" data-saved-only /><span data-copy="savedOnly">Tikai piespraustās personas</span></label>
    </form></div>
    <details class="download-menu" data-person-download><summary><i data-lucide="download" aria-hidden="true"></i><span data-person-download-label>Lejupielādēt</span><i data-lucide="chevron-down" aria-hidden="true"></i></summary><div class="download-options"><button type="button" data-export>CSV</button></div></details>
   </aside>
   <div class="browser-main">
    <div class="browser-top"><label class="field search-field"><span class="sr-only" data-copy="search">Meklēt personu</span><input type="search" name="q" data-query autocomplete="off" /></label>
     <div class="view-switch people-roles" role="group" data-copy-aria="role"><button type="button" data-role="" aria-pressed="true" data-copy="all">Visi</button><button type="button" data-role="narrator" aria-pressed="false" data-copy="narrators">Teicēji</button><button type="button" data-role="collector" aria-pressed="false" data-copy="collectors">Pierakstītāji</button></div>
    </div>
    <div class="browser-toolbar"><div class="result-summary"><span data-result-status role="status" aria-live="polite"></span><button class="clear-pins" type="button" data-copy-link data-copy-aria="copyLink" aria-label="Kopēt atlases saiti" data-tooltip="Kopēt atlases saiti" hidden><i data-lucide="link" aria-hidden="true"></i></button></div>
     <div class="view-tools"><div class="card-sort"><span data-copy="sort">Kārtot</span><select class="sr-only" tabindex="-1" aria-hidden="true" data-sort>{sortOptions.map(([value,key])=><option value={value} data-copy={key}></option>)}</select><details class="sort-menu" data-person-sort-menu><summary><span data-person-sort-label></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary><div class="sort-menu-options">{sortCriteria.map(([value,key])=><button type="button" data-person-sort={value} aria-pressed="false"><i data-lucide="check" aria-hidden="true"></i><span data-copy={key}></span></button>)}</div></details><button class="sort-direction" type="button" data-person-sort-direction hidden><i data-lucide="arrow-up" aria-hidden="true"></i></button></div>
      <div class="view-switch person-view-switch" role="group" data-copy-aria="view"><button type="button" data-view="list" aria-pressed="true"><i data-lucide="list" aria-hidden="true"></i><span data-copy="list">Saraksts</span></button><button type="button" data-view="table" aria-pressed="false"><i data-lucide="layout-grid" aria-hidden="true"></i><span data-copy="table">Tabula</span></button></div>
     </div>
    </div>
    <p class="search-help" data-feedback role="status"></p>
    <div data-person-results></div>
    <div class="pagination-row"><span class="page-label" data-person-page-label></span><nav class="pagination" data-person-pages aria-label="Rezultātu lapas"></nav></div>
    <noscript>Lai meklētu personas, ieslēdziet JavaScript. <a href={`${base}teksti/`}>Atvērt teiku pārlūku</a>.</noscript>
   </div>
  </section>
 </div>
 <script type="application/json" id="people-data" is:inline set:html={JSON.stringify({base,profiles,records}).replace(/</g,'\\u003c')} />
 <script>import '../../persons/browser';</script>
</BaseLayout>

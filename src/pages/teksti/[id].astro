---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { legends, resolveLegend, sourceLabel, legendYear, displayPersonName, type Legend } from '../../lib/data';
const base = import.meta.env.BASE_URL;
export function getStaticPaths() { return legends.map((legend, index) => ({ params: { id: legend.id }, props: { legend, index } })); }
const { legend, index } = Astro.props as { legend: Legend; index: number };
const data = resolveLegend(legend), previous = legends[index - 1], next = legends[index + 1], year = legendYear(legend);
const missingValue = '—';
const basicRows = [['', 'ID', legend.id], ['meta.place', 'Vieta', data.place?.name || missingValue], ['meta.narrator', 'Teicējs', displayPersonName(data.narrator) || missingValue], ['meta.collector', 'Pierakstītājs', displayPersonName(data.collector) || missingValue], ['meta.year', 'Gads', year || missingValue]];
const allSources = [...data.primarySources, ...data.secondarySources];
const hasSources = allSources.length > 0 || Boolean(legend.primarySourceRaw || legend.secondarySourceRaw);
const publicUrl = new URL(`${base}teksti/${legend.id}/`, Astro.site ?? Astro.url.origin).href;
const narratorName = displayPersonName(data.narrator), collectorName = displayPersonName(data.collector);
const trimPeriod = (value: string) => value.replace(/[.\s]+$/,'');
const shortCitation = `Latviešu pasakas un teikas, ${legend.volume}. sējums, ID ${legend.id}. sast. Pēteris Šmits. 1925–1937. Pieejams: ${publicUrl}`;
const extendedCitation = [
  `Latviešu pasakas un teikas, ${legend.volume}. sējums,`,
  'sast. Pēteris Šmits.',
  '1925–1937.',
  `ID ${legend.id}.`,
  legend.title.lv ? `${trimPeriod(legend.title.lv)}.` : '',
  narratorName ? `Teicējs: ${trimPeriod(narratorName)}.` : '',
  collectorName ? `Pierakstītājs: ${trimPeriod(collectorName)}.` : '',
  data.place?.name ? `Pierakstīšanas vieta: ${data.place.name}.` : '',
  year ? `Pierakstīšanas gads: ${year}.` : '',
  `Pieejams: ${publicUrl}`,
].filter(Boolean).join(' ');
const shareMetadata = [
  `ID: ${legend.id}.`,
  data.place?.name ? `Vieta: ${data.place.name}.` : '',
  year ? `Gads: ${year}.` : '',
  narratorName ? `Stāstīja: ${narratorName.replace(/[.\s]+$/,'')}.` : '',
  collectorName ? `Pierakstīja: ${collectorName.replace(/[.\s]+$/,'')}.` : '',
].filter(Boolean).join(' ');
const lvShareText = [legend.title.lv || 'Bez nosaukuma', legend.text.lv || 'Teksts nav norādīts.', shareMetadata, publicUrl].join('\n\n');
const deShareText = [legend.title.de || 'Ohne Titel', legend.text.de || 'Text nicht angegeben.', shareMetadata, publicUrl].join('\n\n');
const parallelShareText = [legend.title.lv || 'Bez nosaukuma', 'Latviski', legend.text.lv || 'Teksts nav norādīts.', legend.title.de || 'Ohne Titel', 'Deutsch', legend.text.de || 'Text nicht angegeben.', shareMetadata, publicUrl].join('\n\n');
---
<BaseLayout title={legend.title.lv || legend.id} active="browse">
  <article class="detail">
    <div class="detail-top"><a class="back-link icon-link" href={`${base}teksti/`} data-back><i data-lucide="arrow-left"></i> Atpakaļ</a><div class="detail-actions"><button class="copy-icon" type="button" data-copy-link={publicUrl} aria-label="Kopēt saiti" title="Kopēt saiti"><i data-lucide="link"></i></button><button class="copy-icon" type="button" data-copy data-copy-lv={lvShareText} data-copy-de={deShareText} data-copy-parallel={parallelShareText} aria-label="Kopēt teiku" title="Kopēt teiku"><i data-lucide="copy"></i></button><div class="citation-control"><button class="copy-icon citation-toggle" type="button" data-citation-toggle aria-expanded="false" aria-controls="citation-panel" aria-label="Citēt teiku" title="Citēt teiku"><i data-lucide="quote"></i></button><section class="citation-panel" id="citation-panel" data-citation-panel hidden aria-labelledby="citation-title"><div class="citation-panel-head"><h2 id="citation-title" data-i18n="detail.citation">Citēšana</h2><button type="button" class="citation-close" data-citation-close aria-label="Aizvērt citēšanu"><i data-lucide="x"></i></button></div><article><h3 data-i18n="detail.shortCitation">Īsā atsauce</h3><p>{shortCitation}</p><button type="button" class="citation-copy" data-citation-copy={shortCitation}><i data-lucide="copy"></i><span data-i18n="common.copy">Kopēt</span></button></article><article><h3 data-i18n="detail.extendedCitation">Paplašinātā atsauce</h3><p>{extendedCitation}</p><button type="button" class="citation-copy" data-citation-copy={extendedCitation}><i data-lucide="copy"></i><span data-i18n="common.copy">Kopēt</span></button></article></section></div></div></div>
    <header class="title-row"><div><h1 data-title-lang="lv">{legend.title.lv || 'Bez nosaukuma'}</h1><h1 data-title-lang="de" lang="de">{legend.title.de || 'Ohne Titel'}</h1></div></header>
    <div class="mode-tabs" role="tablist" aria-label="Šīs teikas valodas skats"><button role="tab" data-mode="lv">Latviski</button><button role="tab" data-mode="de">Deutsch</button><button role="tab" data-mode="parallel">Paralēli</button></div>
    <div class="detail-grid">
      <div class="reading-column">
        <div class="texts" data-texts><section class="text-panel" data-lang="lv" aria-labelledby="lv-heading"><h2 id="lv-heading">LATVISKI</h2><div class="legend-text">{legend.text.lv || 'Teksts nav norādīts.'}</div></section><section class="text-panel" data-lang="de" lang="de" aria-labelledby="de-heading"><h2 id="de-heading">DEUTSCH</h2><div class="legend-text">{legend.text.de || 'Text nicht angegeben.'}</div></section></div>
        <details class="information" data-information open><summary><span><span data-i18n="detail.information">Informācija</span><small data-i18n="detail.infoHelp">par teiku un tās avotiem</small></span><i data-lucide="chevron-down"></i></summary><div class="information-body"><dl>{basicRows.map(([key,label,value]) => <div class="metadata-row"><dt data-i18n={key || undefined}>{label}</dt><dd>{value}</dd></div>)}</dl><details class="more-metadata"><summary><span data-i18n="detail.moreMetadata">Papildu metadati</span><i data-lucide="chevron-down"></i></summary><dl><div class="metadata-row"><dt data-i18n="meta.volume">Sējums</dt><dd>{legend.volume}. sējums</dd></div><div class="metadata-row"><dt data-i18n="meta.theme">Tēma</dt><dd>{legend.chapter.lv || 'Nav norādīts'}{legend.chapter.de && <small lang="de"><br />{legend.chapter.de}</small>}</dd></div>{legend.originalMetadata && <div class="metadata-row"><dt data-i18n="meta.original">Oriģinālie metadati</dt><dd>{legend.originalMetadata}</dd></div>}{hasSources && <div class="metadata-row"><dt data-i18n="meta.sources">Avoti</dt><dd>{allSources.length ? <ul class="source-list">{allSources.map(({source,relation}) => <li>{source.url ? <a href={source.url} target="_blank" rel="noopener noreferrer">{sourceLabel(source)}</a> : sourceLabel(source)}{relation.rawCitation && <small><br />{relation.rawCitation}</small>}</li>)}</ul> : (legend.primarySourceRaw || legend.secondarySourceRaw)}</dd></div>}</dl></details></div></details>
        {(legend.comments || legend.notes) && <aside class="editorial" aria-label="Redakcionālā informācija">{legend.comments && <details><summary>Redaktora komentārs</summary><p>{legend.comments}</p></details>}{legend.notes && <details><summary>Redakcionālās piezīmes</summary><p>{legend.notes}</p></details>}</aside>}
        <nav class="prev-next" aria-label="Blakus teikas" data-prev-next data-current-id={legend.id}><a href={previous ? `${base}teksti/${previous.id}/` : '#'} data-previous hidden={!previous}><span class="nav-direction"><i data-lucide="arrow-left"></i> Iepriekšējā teika</span><span class="legend-nav-title">{previous ? (previous.title.lv || previous.title.de || previous.id) : ''}</span></a><a href={next ? `${base}teksti/${next.id}/` : '#'} data-next hidden={!next}><span class="nav-direction">Nākamā teika <i data-lucide="arrow-right"></i></span><span class="legend-nav-title">{next ? (next.title.lv || next.title.de || next.id) : ''}</span></a></nav>
      </div>
    </div>
  </article>
  <script>
    const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-mode]')],panels=[...document.querySelectorAll<HTMLElement>('[data-lang]')],titles=[...document.querySelectorAll<HTMLElement>('[data-title-lang]')],texts=document.querySelector<HTMLElement>('[data-texts]')!;
    const chapterMeta=document.querySelector<HTMLElement>('.metadata-row dt[data-i18n="meta.theme"]+dd'),chapterLvNode=chapterMeta?.firstChild,chapterLvText=chapterLvNode?.textContent||'',chapterDeMeta=chapterMeta?.querySelector<HTMLElement>('small[lang="de"]'),chapterBreak=chapterDeMeta?.querySelector<HTMLElement>('br');const syncChapterMeta=(mode:string)=>{if(chapterLvNode)chapterLvNode.textContent=mode==='de'?'':chapterLvText;if(chapterDeMeta)chapterDeMeta.hidden=mode==='lv';if(chapterBreak)chapterBreak.hidden=mode==='de'};
    let currentMode=document.documentElement.dataset.contentMode||'parallel';
    const hashForMode=(mode:string)=>mode==='parallel'?'lv-de':mode;
    const modeFromHash=()=>location.hash==='#lv'?'lv':location.hash==='#de'?'de':location.hash==='#lv-de'?'parallel':null;
    function setMode(mode:string,updateHash=false){currentMode=mode;document.documentElement.dataset.contentMode=mode;localStorage.setItem('teikas-content-mode',mode);tabs.forEach(t=>t.setAttribute('aria-selected',String(t.dataset.mode===mode)));panels.forEach(p=>p.hidden=mode!=='parallel'&&p.dataset.lang!==mode);titles.forEach(t=>t.hidden=mode!=='parallel'&&t.dataset.titleLang!==mode);texts.classList.toggle('single',mode!=='parallel');syncChapterMeta(mode);if(updateHash)history.replaceState(null,'',`#${hashForMode(mode)}`)}
    tabs.forEach(t=>{t.addEventListener('click',()=>setMode(t.dataset.mode!,true));t.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const i=tabs.indexOf(t);tabs[(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length].focus()}})});setMode(modeFromHash()||document.documentElement.dataset.contentMode||'parallel');window.addEventListener('hashchange',()=>{const hashMode=modeFromHash();if(hashMode)setMode(hashMode)});
    window.addEventListener('content-mode-change',(event)=>setMode((event as CustomEvent).detail));
    async function copyText(text:string){try{await navigator.clipboard.writeText(text)}catch{const area=document.createElement('textarea');area.value=text;area.style.position='fixed';area.style.opacity='0';document.body.append(area);area.select();document.execCommand('copy');area.remove()}}
    function showCopied(button:HTMLButtonElement,restoreIcon='copy'){const icon=button.querySelector<HTMLElement>('[data-lucide]')!,label=button.querySelector<HTMLElement>('span'),oldLabel=label?.textContent||'';button.classList.add('copied');icon.dataset.lucide='check';if(label)label.textContent='Nokopēts';(window as any).renderLucideIcons?.();setTimeout(()=>{button.classList.remove('copied');icon.dataset.lucide=restoreIcon;if(label)label.textContent=oldLabel;(window as any).renderLucideIcons?.()},1800)}
    document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click',async(e)=>{const button=e.currentTarget as HTMLButtonElement,text=currentMode==='lv'?button.dataset.copyLv:currentMode==='de'?button.dataset.copyDe:button.dataset.copyParallel,tr=(key:string)=>(window as any).teikasT?.(key)||key;await copyText(text||'');button.setAttribute('aria-label',tr('detail.copied'));showCopied(button);setTimeout(()=>button.setAttribute('aria-label',tr('detail.copy')),1800)});
    document.querySelector<HTMLButtonElement>('[data-copy-link]')?.addEventListener('click',async event=>{const button=event.currentTarget as HTMLButtonElement,tr=(key:string)=>(window as any).teikasT?.(key)||key;await copyText(button.dataset.copyLink||location.href);button.setAttribute('aria-label',tr('detail.copied'));showCopied(button,'link');setTimeout(()=>button.setAttribute('aria-label',tr('detail.copyLink')),1800)});
    const citationToggle=document.querySelector<HTMLButtonElement>('[data-citation-toggle]')!,citationPanel=document.querySelector<HTMLElement>('[data-citation-panel]')!;const setCitationOpen=(open:boolean)=>{citationPanel.hidden=!open;citationToggle.setAttribute('aria-expanded',String(open))};citationToggle.addEventListener('click',event=>{event.stopPropagation();setCitationOpen(citationPanel.hasAttribute('hidden'))});document.querySelector('[data-citation-close]')?.addEventListener('click',()=>setCitationOpen(false));document.querySelectorAll<HTMLButtonElement>('[data-citation-copy]').forEach(button=>button.addEventListener('click',async()=>{await copyText(button.dataset.citationCopy||'');showCopied(button)}));citationPanel.addEventListener('click',event=>event.stopPropagation());document.addEventListener('click',()=>setCitationOpen(false));document.addEventListener('keydown',event=>{if(event.key==='Escape')setCitationOpen(false)});
    document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click',e=>{if(document.referrer.startsWith(location.origin)){e.preventDefault();history.back()}});
    type BrowseNeighbour={id:string;titleLv:string;titleDe:string};const neighbourNav=document.querySelector<HTMLElement>('[data-prev-next]');const browseNeighbours=(()=>{try{return JSON.parse(sessionStorage.getItem('teikas-browse-results')||'[]') as BrowseNeighbour[]}catch{return[] as BrowseNeighbour[]}})();const neighbourIndex=browseNeighbours.findIndex(item=>item.id===neighbourNav?.dataset.currentId);const neighbourTitle=(item:BrowseNeighbour)=>currentMode==='de'?(item.titleDe||item.titleLv||item.id):(item.titleLv||item.titleDe||item.id);const setNeighbour=(selector:string,item:BrowseNeighbour|undefined)=>{const anchor=neighbourNav?.querySelector<HTMLAnchorElement>(selector);if(!anchor)return;anchor.hidden=!item;if(!item)return;anchor.href=`${import.meta.env.BASE_URL}teksti/${item.id}/`;const title=anchor.querySelector<HTMLElement>('.legend-nav-title');if(title)title.textContent=neighbourTitle(item)};const syncNeighbours=()=>{if(neighbourIndex<0)return;setNeighbour('[data-previous]',browseNeighbours[neighbourIndex-1]);setNeighbour('[data-next]',browseNeighbours[neighbourIndex+1])};syncNeighbours();tabs.forEach(tab=>tab.addEventListener('click',syncNeighbours));window.addEventListener('content-mode-change',syncNeighbours);
    const info=document.querySelector<HTMLDetailsElement>('[data-information]')!,mobile=matchMedia('(max-width: 850px)');const arrangeInfo=(event:MediaQueryList|MediaQueryListEvent)=>{info.open=!event.matches};arrangeInfo(mobile);mobile.addEventListener('change',arrangeInfo);
  </script>
</BaseLayout>

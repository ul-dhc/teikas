---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { browseRecords, volumes } from '../../lib/data';
const base = import.meta.env.BASE_URL;
const people = [...new Set(browseRecords.map(r=>r.narrator).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'lv'));
const collectorPeople = [...new Set(browseRecords.map(r=>r.collector).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'lv'));
const placeNames = [...new Set(browseRecords.map(r=>r.place).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'lv'));
const years = browseRecords.map(r=>Number(r.year)).filter(Boolean); const minYear=Math.min(...years), maxYear=Math.max(...years);
const undatedCount = browseRecords.filter(r=>!r.year).length;
const undatedPercent = Math.round((undatedCount / browseRecords.length) * 100);
const chapterOptions = [...new Map(browseRecords.filter(r=>r.chapterLv).map(r=>[r.chapterLv,{lv:r.chapterLv,de:r.chapterDe||r.chapterLv}])).values()].sort((a,b)=>a.lv.localeCompare(b.lv,'lv'));
---
<BaseLayout title="Teiku pārlūks" active="browse">
  <header class="browse-hero compact"><div class="shell"><a class="back-link icon-link" href={base}><i data-lucide="arrow-left"></i> Atpakaļ</a><h1>Teiku pārlūks</h1><p class="lede">Meklējiet, salīdziniet un piespraudiet teikas, pie kurām vēlaties atgriezties.</p></div></header>
  <section class="shell browser-layout browser" data-browser>
    <aside class="filter-sidebar"><button class="mobile-filter-toggle" type="button" data-mobile-filter-toggle aria-expanded="false" aria-controls="browse-filters"><span><i data-lucide="sliders-horizontal"></i> Filtri</span><i data-lucide="chevron-down"></i></button><form data-controls id="browse-filters"><div class="filter-title"><h2>Filtri</h2><button class="text-button clear-filters" type="button" data-clear hidden><i data-lucide="rotate-ccw"></i> Notīrīt filtrus</button></div>
      <details class="multi-select" data-multi-filter="theme"><summary><span>Tēmas</span><small data-filter-count="theme">Visas</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only">Meklēt tēmu</span><input type="search" placeholder="Meklēt tēmu…" data-filter-search="theme" /></label><div class="multi-options" data-filter-options="theme">{chapterOptions.map(v=><label data-option={v.lv}><input type="checkbox" value={v.lv} /> <span data-option-lv={v.lv} data-option-de={v.de}>{v.lv}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="narrator"><summary><span>Teicēji</span><small data-filter-count="narrator">Visi</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only">Meklēt teicēju</span><input type="search" placeholder="Meklēt teicēju…" data-filter-search="narrator" /></label><div class="multi-options" data-filter-options="narrator">{people.map(v=><label data-option={v}><input type="checkbox" value={v} /> <span>{v}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="collector"><summary><span>Pierakstītāji</span><small data-filter-count="collector">Visi</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only">Meklēt pierakstītāju</span><input type="search" placeholder="Meklēt pierakstītāju…" data-filter-search="collector" /></label><div class="multi-options" data-filter-options="collector">{collectorPeople.map(v=><label data-option={v}><input type="checkbox" value={v} /> <span>{v}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="place"><summary><span>Vietas</span><small data-filter-count="place">Visas</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only">Meklēt vietu</span><input type="search" placeholder="Meklēt vietu…" data-filter-search="place" /></label><div class="multi-options" data-filter-options="place">{placeNames.map(v=><label data-option={v}><input type="checkbox" value={v} /> <span>{v}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="volume"><summary><span>Sējumi</span><small data-filter-count="volume">Visi</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><div class="multi-options" data-filter-options="volume">{volumes.map(v=><label data-option={v}><input type="checkbox" value={v} /> <span>{v}. sējums</span></label>)}</div></div></details>
      <fieldset class="timeline"><legend>Laika nogrieznis</legend><div class="timeline-values"><output data-year-from>{minYear}</output><span>–</span><output data-year-to>{maxYear}</output></div><div class="dual-range"><span class="range-track" aria-hidden="true"></span><input id="year-from" type="range" min={minYear} max={maxYear} value={minYear}/><input id="year-to" type="range" min={minYear} max={maxYear} value={maxYear}/></div><label class="undated-toggle"><input id="include-undated" type="checkbox" checked /><span>Iekļaut nedatētos tekstus</span><small>{undatedPercent}% jeb {undatedCount.toLocaleString('lv-LV')} teksti nav datēti</small></label></fieldset>
    </form></aside>
    <div class="browser-main"><div class="browser-top"><div class="field search-field"><label for="q">Meklēt</label><input id="q" name="q" type="search" autocomplete="off" placeholder="Meklēt pēc atslēgvārda, teicēja vārda vai vietas…" aria-describedby="search-help" /><small class="search-help" id="search-help" hidden>Frāzes pēdiņās meklē precīzā vārdu secībā. Piemēram: "Reiz bija" "septiņi gadi".</small></div><div class="content-language"><span>Tekstu valoda</span><div class="view-switch"><button data-text-mode="lv">LV</button><button data-text-mode="de">DE</button><button data-text-mode="parallel">LV &amp; DE</button></div></div></div>
      <div class="active-filters" data-active-filters hidden aria-label="Aktīvie filtri"></div><div class="browser-toolbar"><div class="result-summary"><span><span data-count>{browseRecords.length.toLocaleString('lv-LV')}</span> rezultāti</span><span class="page-label" data-page-label></span><button class="clear-pins" type="button" data-clear-pins hidden><i data-lucide="pin-off"></i> Noņemt piespraudes</button></div><div class="view-tools"><label class="card-sort" hidden>Kārtot <select data-card-sort><option value="random">Nejaušā secībā</option><option value="title">Pēc nosaukuma</option><option value="year-desc">Jaunākie vispirms</option><option value="year-asc">Senākie vispirms</option></select></label><div class="view-switch" aria-label="Rezultātu skats"><button type="button" data-view="list"><i data-lucide="list"></i><span>Saraksts</span></button><button type="button" data-view="grid"><i data-lucide="layout-grid"></i><span>Režģis</span></button></div></div></div>
      <div class="list-head" data-list-head><button data-column-sort="id">ID <i data-lucide="arrow-up-down"></i></button><button data-column-sort="title">Nosaukums <i data-lucide="arrow-up-down"></i></button><span>Fragments</span><button data-column-sort="narrator">Teicējs <i data-lucide="arrow-up-down"></i></button><button data-column-sort="collector">Pierakstītājs <i data-lucide="arrow-up-down"></i></button><button data-column-sort="place">Vieta <i data-lucide="arrow-up-down"></i></button><button data-column-sort="year">Gads <i data-lucide="arrow-up-down"></i></button></div>
      <ol class="results-list" data-results></ol><div class="empty" data-empty hidden><strong>Nekas netika atrasts.</strong><br/>Mainiet meklējamo vārdu vai filtrus.</div><nav class="pagination" aria-label="Rezultātu lapas" data-pagination></nav>
    </div>
  </section>
  <script type="application/json" id="browse-data" is:inline set:html={JSON.stringify(browseRecords).replace(/</g,'\\u003c')} />
  <script>
    type R={id:string;volume:string;chapterLv:string;chapterDe:string;titleLv:string;titleDe:string;place:string;collector:string;narrator:string;year:string;excerptLv:string;excerptDe:string};
    const root=document.querySelector<HTMLElement>('[data-browser]')!,data=JSON.parse(document.querySelector('#browse-data')!.textContent||'[]') as R[];
    const q=root.querySelector<HTMLInputElement>('#q')!,searchHelp=root.querySelector<HTMLElement>('#search-help')!,yearFrom=root.querySelector<HTMLInputElement>('#year-from')!,yearTo=root.querySelector<HTMLInputElement>('#year-to')!,includeUndated=root.querySelector<HTMLInputElement>('#include-undated')!,timeline=yearFrom.closest<HTMLElement>('.timeline')!;
    const list=root.querySelector<HTMLOListElement>('[data-results]')!,count=root.querySelector<HTMLElement>('[data-count]')!,empty=root.querySelector<HTMLElement>('[data-empty]')!,pages=root.querySelector<HTMLElement>('[data-pagination]')!,pageLabel=root.querySelector<HTMLElement>('[data-page-label]')!,listHead=root.querySelector<HTMLElement>('[data-list-head]')!,cardSort=root.querySelector<HTMLSelectElement>('[data-card-sort]')!,cardSortWrap=cardSort.closest<HTMLElement>('.card-sort')!,activeFilters=root.querySelector<HTMLElement>('[data-active-filters]')!,clearButton=root.querySelector<HTMLButtonElement>('[data-clear]')!,clearPinsButton=root.querySelector<HTMLButtonElement>('[data-clear-pins]')!,mobileFilterToggle=root.querySelector<HTMLButtonElement>('[data-mobile-filter-toggle]')!,filterSidebar=root.querySelector<HTMLElement>('.filter-sidebar')!;
    type SearchText={lv:string;de:string};type MultiType='theme'|'narrator'|'collector'|'place'|'volume';const selectedThemes=new Set<string>(),selectedNarrators=new Set<string>(),selectedCollectors=new Set<string>(),selectedPlaces=new Set<string>(),selectedVolumes=new Set<string>(),selections:Record<MultiType,Set<string>>={theme:selectedThemes,narrator:selectedNarrators,collector:selectedCollectors,place:selectedPlaces,volume:selectedVolumes},pins=new Set<string>(JSON.parse(localStorage.getItem('teikas-pins')||'[]')),expandedIds=new Set<string>(),seed=Math.random();let page=1,view=localStorage.getItem('teikas-browse-view')||'list',sortKey='random',sortDirection=1,searchIndex:Map<string,SearchText>|null=null,token=0,activeTerms:string[]=[];const size=20;
    const tr=(key:string,values:Record<string,string|number>={})=>(window as any).teikasT?.(key,values)||key;
    const esc=(s:string)=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]!)),fold=(s:string)=>s.toLocaleLowerCase('lv').normalize('NFD').replace(/[\u0300-\u036f]/g,''),searchNorm=(s:string)=>fold(s).replace(/\s+/g,' ').trim(),parseTerms=(value:string)=>{const terms:string[]=[];for(const match of value.matchAll(/"([^"]+)"|“([^”]+)”|(\S+)/g)){const term=searchNorm(match[1]||match[2]||match[3]||'');if(term&&!terms.includes(term))terms.push(term)}return terms};const mode=()=>document.documentElement.dataset.contentMode||'parallel';const hash=(s:string)=>{let h=2166136261;for(const c of s)h=Math.imul(h^c.charCodeAt(0),16777619);return(h>>>0)/4294967296};
    const base=import.meta.env.BASE_URL;
    async function ensureSearch(){if(searchIndex)return searchIndex;const rows=await(await fetch(`${base}search-index.json?v=2`)).json() as ({id:string}&SearchText)[];return searchIndex=new Map(rows.map(r=>[r.id,{lv:r.lv||'',de:r.de||''}]))}
    function title(r:R){return mode()==='lv'?marked(r.titleLv||'Bez nosaukuma',activeTerms):mode()==='de'?`<span lang="de">${marked(r.titleDe||'Ohne Titel',activeTerms)}</span>`:`${marked(r.titleLv||'Bez nosaukuma',activeTerms)}<small lang="de">${marked(r.titleDe||'Nav norādīts',activeTerms)}</small>`}
    function marked(value:string,terms:string[]){if(!terms.length)return esc(value);let normalized='',starts:number[]=[],ends:number[]=[];for(let i=0;i<value.length;){const char=String.fromCodePoint(value.codePointAt(i)!),next=i+char.length,part=fold(char);for(const unit of part){normalized+=unit;starts.push(i);ends.push(next)}i=next}const ranges:[number,number][]=[];for(const term of terms){let from=0,at=-1;while((at=normalized.indexOf(term,from))>=0){ranges.push([starts[at],ends[at+term.length-1]]);from=at+Math.max(1,term.length)}}if(!ranges.length)return esc(value);ranges.sort((a,b)=>a[0]-b[0]);const merged=ranges.reduce<[number,number][]>((all,range)=>{const last=all.at(-1);if(last&&range[0]<=last[1])last[1]=Math.max(last[1],range[1]);else all.push([...range]);return all},[]);let html='',cursor=0;for(const [start,end] of merged){html+=esc(value.slice(cursor,start))+`<mark>${esc(value.slice(start,end))}</mark>`;cursor=end}return html+esc(value.slice(cursor))}function contextual(value:string,terms:string[],fallback:string,expanded=false,limitOverride?:number){const clean=(value||fallback).replace(/\s+/g,' ').trim(),limit=limitOverride??(expanded?900:260),folded=fold(clean),term=terms.find(item=>folded.includes(item))||'';if(!term)return clean.slice(0,limit)+(clean.length>limit?'…':'');const at=folded.indexOf(term),before=Math.min(expanded?260:90,Math.round(limit*.38)),after=Math.max(50,limit-before-term.length);let start=Math.max(0,at-before),end=Math.min(clean.length,at+term.length+after);if(start){const space=clean.indexOf(' ',start);start=space<0?start:space+1}if(end<clean.length){const space=clean.lastIndexOf(' ',end);end=space<0?end:space}return`${start?'…':''}${clean.slice(start,end)}${end<clean.length?'…':''}`}function excerpt(r:R,expanded=false){const full=searchIndex?.get(r.id),lvText=full?.lv||'',deText=full?.de||'',parallel=mode()==='parallel',parallelLimit=parallel&&view==='list'?(expanded?380:145):undefined,lv=contextual(lvText,activeTerms,r.excerptLv,expanded,parallelLimit),de=contextual(deText,activeTerms,r.excerptDe,expanded,parallelLimit),lvHit=activeTerms.some(term=>fold(`${r.titleLv} ${lvText}`).includes(term)),deHit=activeTerms.some(term=>fold(`${r.titleDe} ${deText}`).includes(term));if(parallel)return`<span>${marked(lv,activeTerms)}</span><span class="excerpt-de" lang="de">${marked(de,activeTerms)}</span>`;if(mode()==='de'||deHit&&!lvHit)return`<span class="excerpt-de" lang="de">${marked(de,activeTerms)}</span>`;return marked(lv,activeTerms)}
    function item(r:R){const pinned=pins.has(r.id),expanded=expandedIds.has(r.id),href=`${base}teksti/${r.id}/`,whereWhen=[r.place,r.year].filter(Boolean).join(', '),personMeta=(label:string,value:string)=>value?`<span class="person-meta"><span class="meta-label">${label}:</span> <span class="meta-value">${marked(value.replace(/[.\s]+$/,''),activeTerms)}.</span></span>`:'',people=[personMeta(tr('meta.narrator'),r.narrator),personMeta(tr('meta.collector'),r.collector)].filter(Boolean).join(' '),parallel=mode()==='parallel';return `<li class="result-card${pinned?' is-pinned':''}${expanded?' is-expanded':''}" data-id="${r.id}" data-href="${href}" tabindex="0" aria-expanded="${expanded}" aria-label="${tr(expanded?'browser.collapse':'browser.expand')}: ${esc(r.titleLv||r.id)}"><button class="pin-button" data-pin="${r.id}" aria-pressed="${pinned}" aria-label="${tr(pinned?'browser.unpin':'browser.pin')}"><i data-lucide="pin"></i></button><div class="result-id">${marked(r.id,activeTerms)}</div><h2><a href="${href}" data-title-link>${title(r)}</a></h2><div class="result-excerpt${parallel?' is-parallel':''}">${excerpt(r,expanded)}</div><div class="result-narrator${r.narrator?'':' is-empty'}">${marked(r.narrator||'—',activeTerms)}</div><div class="result-collector${r.collector?'':' is-empty'}">${marked(r.collector||'—',activeTerms)}</div><div class="result-place${r.place?'':' is-empty'}">${marked(r.place||'—',activeTerms)}</div><div class="result-year${r.year?'':' is-empty'}">${marked(r.year||'—',activeTerms)}</div>${whereWhen?`<div class="card-location">${marked(whereWhen,activeTerms)}</div>`:''}${people?`<div class="card-people">${people}</div>`:''}<a class="read-full" href="${href}">${tr('browser.readAll')} <i data-lucide="arrow-right"></i></a></li>`}
    function sortValue(r:R){if(sortKey==='id')return r.id;if(sortKey==='title')return mode()==='de'?r.titleDe:r.titleLv;if(sortKey==='narrator')return r.narrator;if(sortKey==='collector')return r.collector;if(sortKey==='place')return r.place;if(sortKey.startsWith('year'))return r.year;return hash(r.id+seed)}
    function refreshIcons(){(window as any).renderLucideIcons?.()}
    function textMatches(r:R,terms:string[],index:Map<string,SearchText>|null){if(!terms.length)return true;const text=index?.get(r.id),common=[r.id,r.place,r.narrator,r.collector].join(' '),languageText=mode()==='lv'?`${r.titleLv} ${r.chapterLv} ${text?.lv||''}`:mode()==='de'?`${r.titleDe} ${r.chapterDe} ${text?.de||''}`:`${r.titleLv} ${r.chapterLv} ${text?.lv||''} ${r.titleDe} ${r.chapterDe} ${text?.de||''}`,haystack=searchNorm(`${common} ${languageText}`);return terms.every(term=>haystack.includes(term))}
    function filterValue(r:R,type:MultiType){return type==='theme'?r.chapterLv:r[type]}function baseMatches(r:R,skip:MultiType|''=''){return(skip==='theme'||!selectedThemes.size||selectedThemes.has(r.chapterLv))&&(skip==='place'||!selectedPlaces.size||selectedPlaces.has(r.place))&&(skip==='narrator'||!selectedNarrators.size||selectedNarrators.has(r.narrator))&&(skip==='collector'||!selectedCollectors.size||selectedCollectors.has(r.collector))&&(skip==='volume'||!selectedVolumes.size||selectedVolumes.has(r.volume))&&(r.year?(Number(r.year)>=Number(yearFrom.value)&&Number(r.year)<=Number(yearTo.value)):includeUndated.checked)}
    function updateFilterOptions(){(['theme','narrator','collector','place','volume'] as MultiType[]).forEach(type=>{const allowed=new Set(data.filter(r=>baseMatches(r,type)&&textMatches(r,activeTerms,searchIndex)).map(r=>filterValue(r,type))),search=root.querySelector<HTMLInputElement>(`[data-filter-search="${type}"]`),term=search?fold(search.value):'',selected=selections[type];root.querySelectorAll<HTMLElement>(`[data-filter-options="${type}"] [data-option]`).forEach(label=>{const input=label.querySelector<HTMLInputElement>('input')!,available=allowed.has(input.value)||input.checked;label.hidden=!available||!!term&&!fold(input.value).includes(term);input.disabled=!available});const allLabel=type==='theme'||type==='place'?'Visas':'Visi';root.querySelector(`[data-filter-count="${type}"]`)!.textContent=selected.size?`${selected.size} atlasīti`:allLabel})}
    function renderActiveFilters(){const entries:[string,string,string][]=[];activeTerms.forEach(term=>entries.push(['q',tr('browser.searched',{value:term}),term]));selectedThemes.forEach(v=>entries.push(['theme',tr('browser.themeTag',{value:v}),v]));selectedPlaces.forEach(v=>entries.push(['place',tr('browser.placeTag',{value:v}),v]));selectedVolumes.forEach(v=>entries.push(['volume',tr('browser.volumeTag',{value:v}),v]));selectedNarrators.forEach(v=>entries.push(['narrator',tr('browser.narratorTag',{value:v}),v]));selectedCollectors.forEach(v=>entries.push(['collector',tr('browser.collectorTag',{value:v}),v]));if(yearFrom.value!==yearFrom.min||yearTo.value!==yearTo.max)entries.push(['years',`${yearFrom.value}–${yearTo.value}`,'']);if(!includeUndated.checked)entries.push(['undated',tr('browser.withoutUndated'),'']);activeFilters.hidden=!entries.length;clearButton.hidden=!entries.length;activeFilters.innerHTML=entries.map(([type,label,value])=>`<button type="button" data-remove-filter="${type}" data-filter-value="${esc(value)}">${esc(label)} <i data-lucide="x"></i></button>`).join('');refreshIcons();activeFilters.querySelectorAll<HTMLButtonElement>('button').forEach(button=>button.addEventListener('click',()=>{const type=button.dataset.removeFilter!,value=button.dataset.filterValue!;if(type==='q'){const remaining=parseTerms(q.value).filter(term=>term!==value);q.value=remaining.map(term=>term.includes(' ')?`"${term}"`:term).join(' ')}if((['theme','place','narrator','collector','volume'] as string[]).includes(type)){selections[type as MultiType].delete(value);syncFilterChecks()}if(type==='years'){yearFrom.value=yearFrom.min;yearTo.value=yearTo.max}if(type==='undated')includeUndated.checked=true;syncYears();page=1;render()}))}
    async function render(){searchHelp.hidden=!q.value.trim();const current=++token,terms=parseTerms(q.value.trim()),index=terms.length?await ensureSearch():null;if(current!==token)return;activeTerms=terms;let rows=data.filter(r=>textMatches(r,terms,index)&&baseMatches(r));rows.sort((a,b)=>{const pd=Number(pins.has(b.id))-Number(pins.has(a.id));return pd||String(sortValue(a)).localeCompare(String(sortValue(b)),'lv',{numeric:true})*sortDirection});const total=Math.max(1,Math.ceil(rows.length/size));page=Math.min(page,total);list.innerHTML=rows.slice((page-1)*size,page*size).map(item).join('');count.textContent=rows.length.toLocaleString('lv-LV');pageLabel.textContent=`${page}. lapa no ${total}`;clearPinsButton.hidden=!pins.size;empty.hidden=!!rows.length;list.hidden=!rows.length;pages.innerHTML='';[1,page-1,page,page+1,total].filter((v,i,a)=>total>1&&v>0&&v<=total&&a.indexOf(v)===i).sort((a,b)=>a-b).forEach((n,i,a)=>{if(i&&n-a[i-1]>1)pages.append('…');const b=document.createElement('button');b.textContent=String(n);if(n===page)b.setAttribute('aria-current','page');b.addEventListener('click',()=>{page=n;render()});pages.append(b)});updateFilterOptions();renderActiveFilters();refreshIcons();list.querySelectorAll<HTMLButtonElement>('[data-pin]').forEach(b=>b.addEventListener('click',event=>{event.preventDefault();event.stopPropagation();const id=b.dataset.pin!;pins.has(id)?pins.delete(id):pins.add(id);localStorage.setItem('teikas-pins',JSON.stringify([...pins]));render()}));list.querySelectorAll<HTMLElement>('[data-href]').forEach(card=>{const activate=async()=>{if(view==='grid'&&!matchMedia('(max-width:600px)').matches){location.href=card.dataset.href!;return}await ensureSearch();expandedIds.has(card.dataset.id!)?expandedIds.delete(card.dataset.id!):expandedIds.add(card.dataset.id!);render()};card.addEventListener('click',event=>{const target=event.target as HTMLElement;if(target.closest('[data-pin],.read-full'))return;if(target.closest('[data-title-link]'))event.preventDefault();activate()});card.addEventListener('keydown',event=>{if(event.key==='Enter'&&event.target===card){event.preventDefault();activate()}})})}
    function updateSortState(){root.querySelectorAll<HTMLButtonElement>('[data-column-sort]').forEach(button=>{const active=view==='list'&&button.dataset.columnSort===sortKey;button.setAttribute('aria-pressed',String(active));if(active)button.dataset.sortDirection=sortDirection===1?'ascending':'descending';else delete button.dataset.sortDirection})}function setMode(m:string){document.documentElement.dataset.contentMode=m;localStorage.setItem('teikas-content-mode',m);root.querySelectorAll<HTMLButtonElement>('[data-text-mode]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.textMode===m)));render()}function setView(v:string){view=v;root.dataset.view=v;localStorage.setItem('teikas-browse-view',v);root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.view===v)));listHead.hidden=v!=='list';cardSortWrap.hidden=v!=='grid';updateSortState()}
    function syncFilterChecks(){(['theme','narrator','collector','place','volume'] as MultiType[]).forEach(type=>root.querySelectorAll<HTMLInputElement>(`[data-filter-options="${type}"] input`).forEach(input=>input.checked=selections[type].has(input.value)))}root.querySelectorAll<HTMLInputElement>('[data-filter-options] input').forEach(input=>input.addEventListener('change',()=>{const type=input.closest<HTMLElement>('[data-filter-options]')!.dataset.filterOptions as MultiType,set=selections[type];input.checked?set.add(input.value):set.delete(input.value);page=1;render()}));root.querySelectorAll<HTMLInputElement>('[data-filter-search]').forEach(input=>input.addEventListener('input',updateFilterOptions));root.querySelector('[data-clear]')?.addEventListener('click',()=>{q.value='';yearFrom.value=yearFrom.min;yearTo.value=yearTo.max;includeUndated.checked=true;Object.values(selections).forEach(set=>set.clear());syncFilterChecks();syncYears();render()});clearPinsButton.addEventListener('click',()=>{pins.clear();localStorage.setItem('teikas-pins','[]');render()});
    function syncYears(){if(+yearFrom.value>+yearTo.value)[yearFrom.value,yearTo.value]=[yearTo.value,yearFrom.value];const fromOutput=root.querySelector<HTMLElement>('[data-year-from]')!,toOutput=root.querySelector<HTMLElement>('[data-year-to]')!;fromOutput.textContent=yearFrom.value;toOutput.textContent=yearTo.value;const fromChanged=yearFrom.value!==yearFrom.min,toChanged=yearTo.value!==yearTo.max;fromOutput.classList.toggle('is-changed',fromChanged);toOutput.classList.toggle('is-changed',toChanged);timeline.classList.toggle('is-active',fromChanged||toChanged);const min=+yearFrom.min,max=+yearFrom.max,left=((+yearFrom.value-min)/(max-min))*100,right=100-((+yearTo.value-min)/(max-min))*100;root.querySelector<HTMLElement>('.range-track')!.style.setProperty('--range-left',`${left}%`);root.querySelector<HTMLElement>('.range-track')!.style.setProperty('--range-right',`${right}%`)}const syncSearchHelp=()=>{searchHelp.hidden=!q.value.trim()};let rangeFrame=0;root.querySelector('[data-controls]')!.addEventListener('input',event=>{if((event.target as HTMLElement).closest('[data-multi-filter]'))return;syncYears();page=1;if((event.target as HTMLInputElement).type==='range'){cancelAnimationFrame(rangeFrame);rangeFrame=requestAnimationFrame(()=>render())}else render()});q.addEventListener('input',()=>{syncSearchHelp();page=1;render()});mobileFilterToggle.addEventListener('click',()=>{const open=!filterSidebar.classList.contains('filters-open');filterSidebar.classList.toggle('filters-open',open);mobileFilterToggle.setAttribute('aria-expanded',String(open))});root.querySelectorAll<HTMLButtonElement>('[data-text-mode]').forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.textMode!)));root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(b=>b.addEventListener('click',()=>setView(b.dataset.view!)));root.querySelectorAll<HTMLButtonElement>('[data-column-sort]').forEach(b=>b.addEventListener('click',()=>{const k=b.dataset.columnSort!;sortDirection=sortKey===k?-sortDirection:1;sortKey=k;updateSortState();render()}));cardSort.addEventListener('change',()=>{sortKey=cardSort.value;sortDirection=sortKey==='year-desc'?-1:1;updateSortState();render()});const initial=new URLSearchParams(location.search).get('q');if(initial)q.value=initial;const translateThemeOptions=(lang:string)=>root.querySelectorAll<HTMLElement>('[data-option-lv]').forEach(option=>option.textContent=lang==='de'?(option.dataset.optionDe||option.dataset.optionLv!):option.dataset.optionLv!);window.addEventListener('ui-language-change',event=>{translateThemeOptions((event as CustomEvent).detail);render()});translateThemeOptions(document.documentElement.dataset.uiLang||'lv');syncSearchHelp();syncYears();syncFilterChecks();setMode(mode());setView(view);render();
    async function animateReorder(goToFirstPage=false){const before=new Map<string,number>();list.querySelectorAll<HTMLElement>('.result-card[data-id]').forEach(item=>before.set(item.dataset.id!,item.getBoundingClientRect().top));if(goToFirstPage)page=1;await render();if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;const animations:Animation[]=[];list.querySelectorAll<HTMLElement>('.result-card[data-id]').forEach(item=>{const oldTop=before.get(item.dataset.id!);if(oldTop===undefined)return;const delta=oldTop-item.getBoundingClientRect().top;if(Math.abs(delta)>1)animations.push(item.animate([{transform:`translateY(${delta}px)`},{transform:'translateY(0)'}],{duration:680,easing:'cubic-bezier(.22,.75,.2,1)'}))});await Promise.allSettled(animations.map(animation=>animation.finished))}
    list.addEventListener('click',event=>{const pin=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-pin]');if(!pin)return;event.preventDefault();event.stopImmediatePropagation();const id=pin.dataset.pin!,card=pin.closest<HTMLElement>('.result-card')!,willPin=!pins.has(id);willPin?pins.add(id):pins.delete(id);localStorage.setItem('teikas-pins',JSON.stringify([...pins]));pin.setAttribute('aria-pressed',String(willPin));pin.setAttribute('aria-label',`${willPin?'Atspraust':'Piespraust'} teiku`);card.classList.toggle('is-pinned',willPin);clearPinsButton.hidden=!pins.size;pin.disabled=true;window.setTimeout(()=>animateReorder(willPin),360)},true);
    const undatedLabel=root.querySelector<HTMLElement>('.undated-toggle small'),undatedValues=undatedLabel?.textContent?.match(/(\d+)%.*?(\d+)/);const translateUndated=()=>{if(undatedLabel&&undatedValues)undatedLabel.textContent=tr('filters.undatedCount',{percent:undatedValues[1],count:Number(undatedValues[2]).toLocaleString(document.documentElement.lang)})};window.addEventListener('ui-language-change',translateUndated);translateUndated();
    window.addEventListener('content-mode-change',(event)=>setMode((event as CustomEvent).detail));
  </script>
</BaseLayout>

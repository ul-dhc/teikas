---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { browseRecords, volumes } from '../../lib/data';
const base = import.meta.env.BASE_URL;
const people = [...new Set(browseRecords.map(r=>r.narrator).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'lv'));
const collectorPeople = [...new Set(browseRecords.map(r=>r.collector).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'lv'));
const placeNames = [...new Set(browseRecords.map(r=>r.place).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'lv'));
const years = browseRecords.map(r=>Number(r.year)).filter(Boolean); const minYear=Math.min(...years), maxYear=Math.max(...years);
const undatedCount = browseRecords.filter(r=>!r.year).length;
const undatedPercent = Math.round((undatedCount / browseRecords.length) * 100);
const chapterOptions = [...new Map(browseRecords.filter(r=>r.chapterLv).map(r=>[r.chapterLv,{lv:r.chapterLv,de:r.chapterDe||r.chapterLv}])).values()].sort((a,b)=>a.lv.localeCompare(b.lv,'lv'));
---
<BaseLayout title="Teiku pārlūks" active="browse">
  <header class="browse-hero compact"><div class="shell"><a class="back-link icon-link" href={base}><i data-lucide="arrow-left"></i> Atpakaļ</a><h1>Teiku pārlūks</h1><p class="lede">Meklējiet, izpētiet un piespraudiet teikas, pie kurām vēlaties atgriezties.</p></div></header>
  <section class="shell browser-layout browser" data-browser>
    <aside class="filter-sidebar"><button class="mobile-filter-toggle" type="button" data-mobile-filter-toggle aria-expanded="false" aria-controls="browse-filters"><span><i data-lucide="sliders-horizontal"></i> Filtri</span><i data-lucide="chevron-down"></i></button><form data-controls id="browse-filters"><div class="filter-title"><h2>Filtri</h2><button class="text-button clear-filters" type="button" data-clear hidden><i data-lucide="rotate-ccw"></i> Notīrīt filtrus</button></div>
      <details class="multi-select" data-multi-filter="theme"><summary><span>Tēmas</span><small data-filter-count="theme">Visas</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only">Meklēt tēmu</span><input type="search" placeholder="Meklēt tēmu…" data-filter-search="theme" /></label><div class="multi-options" data-filter-options="theme">{chapterOptions.map(v=><label data-option={v.lv}><input type="checkbox" value={v.lv} /> <span data-option-lv={v.lv} data-option-de={v.de}>{v.lv}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="narrator"><summary><span>Teicēji</span><small data-filter-count="narrator">Visi</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only">Meklēt teicēju</span><input type="search" placeholder="Meklēt teicēju…" data-filter-search="narrator" /></label><label class="unknown-toggle"><input id="include-unknown-narrator" type="checkbox" checked /> <span>Iekļaut nezināmos teicējus</span></label><div class="multi-options" data-filter-options="narrator">{people.map(v=><label data-option={v}><input type="checkbox" value={v} /> <span>{v}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="collector"><summary><span>Pierakstītāji</span><small data-filter-count="collector">Visi</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only">Meklēt pierakstītāju</span><input type="search" placeholder="Meklēt pierakstītāju…" data-filter-search="collector" /></label><label class="unknown-toggle"><input id="include-unknown-collector" type="checkbox" checked /> <span>Iekļaut nezināmos pierakstītājus</span></label><div class="multi-options" data-filter-options="collector">{collectorPeople.map(v=><label data-option={v}><input type="checkbox" value={v} /> <span>{v}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="place"><summary><span>Vietas</span><small data-filter-count="place">Visas</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><label class="multi-search"><span class="sr-only">Meklēt vietu</span><input type="search" placeholder="Meklēt vietu…" data-filter-search="place" /></label><label class="unknown-toggle"><input id="include-unknown-place" type="checkbox" checked /> <span>Iekļaut nezināmās vietas</span></label><div class="multi-options" data-filter-options="place">{placeNames.map(v=><label data-option={v}><input type="checkbox" value={v} /> <span>{v}</span></label>)}</div></div></details>
      <details class="multi-select" data-multi-filter="volume"><summary><span>Sējumi</span><small data-filter-count="volume">Visi</small><i data-lucide="chevron-down"></i></summary><div class="multi-panel"><div class="multi-options" data-filter-options="volume">{volumes.map(v=><label data-option={v}><input type="checkbox" value={v} /> <span>{v}. sējums</span></label>)}</div></div></details>
      <fieldset class="timeline"><legend>Laika nogrieznis</legend><div class="timeline-values"><output data-year-from>{minYear}</output><span>–</span><output data-year-to>{maxYear}</output></div><div class="dual-range"><span class="range-track" aria-hidden="true"></span><input id="year-from" type="range" min={minYear} max={maxYear} value={minYear}/><input id="year-to" type="range" min={minYear} max={maxYear} value={maxYear}/></div><label class="undated-toggle"><input id="include-undated" type="checkbox" checked /><span>Iekļaut nedatētos tekstus</span><small>{undatedPercent}% jeb {undatedCount.toLocaleString('lv-LV')} teksti nav datēti</small></label></fieldset>
    </form></aside>
    <div class="browser-main"><div class="browser-top"><div class="field search-field"><label class="sr-only" for="q">Meklēt</label><input id="q" name="q" type="search" autocomplete="off" placeholder="Meklēt pēc atslēgvārda, teicēja vārda vai vietas…" aria-describedby="search-help" /><small class="search-help" id="search-help" hidden>Frāzes pēdiņās meklē precīzā vārdu secībā. Piemēram: "Reiz bija" "septiņi gadi".</small></div><div class="content-language"><span>Tekstu valoda</span><div class="view-switch"><button data-text-mode="lv">LV</button><button data-text-mode="de">DE</button><button data-text-mode="parallel">LV &amp; DE</button></div></div></div>
      <div class="active-filters" data-active-filters hidden aria-label="Aktīvie filtri"></div><div class="browser-toolbar"><div class="result-summary"><span data-result-count-label>20 no <span data-count>{browseRecords.length.toLocaleString('lv-LV')}</span> rezultātiem</span><span class="page-label" data-page-label></span><button class="clear-pins" type="button" data-clear-pins hidden><i data-lucide="pin-off"></i> Noņemt piespraudes</button></div><div class="view-tools"><div class="card-sort" hidden><span>Kārtot</span><select class="sr-only" data-card-sort tabindex="-1" aria-hidden="true"><option value="random">Nejaušā secībā</option><option value="title">Pēc nosaukuma</option><option value="id">Pēc ID</option><option value="place">Pēc vietas</option><option value="collector">Pēc pierakstītāja</option><option value="narrator">Pēc teicēja</option><option value="year">Pēc gada</option></select><details class="sort-menu" data-sort-menu><summary><span data-sort-label>Nejaušā secībā</span><i data-lucide="chevron-down"></i></summary><div class="sort-menu-options"><button type="button" data-sort-value="random" aria-pressed="true"><i data-lucide="check"></i><span>Nejaušā secībā</span></button><button type="button" data-sort-value="title" aria-pressed="false"><i data-lucide="check"></i><span>Pēc nosaukuma</span></button><button type="button" data-sort-value="id" aria-pressed="false"><i data-lucide="check"></i><span>Pēc ID</span></button><button type="button" data-sort-value="place" aria-pressed="false"><i data-lucide="check"></i><span>Pēc vietas</span></button><button type="button" data-sort-value="collector" aria-pressed="false"><i data-lucide="check"></i><span>Pēc pierakstītāja</span></button><button type="button" data-sort-value="narrator" aria-pressed="false"><i data-lucide="check"></i><span>Pēc teicēja</span></button><button type="button" data-sort-value="year" aria-pressed="false"><i data-lucide="check"></i><span>Pēc gada</span></button></div></details></div><div class="view-switch" aria-label="Rezultātu skats"><button type="button" data-view="list"><i data-lucide="list"></i><span>Saraksts</span></button><button type="button" data-view="grid"><i data-lucide="layout-grid"></i><span>Režģis</span></button></div></div></div>
      <div class="list-head" data-list-head><button data-column-sort="id">ID <i data-lucide="arrow-up-down"></i></button><button data-column-sort="title">Nosaukums <i data-lucide="arrow-up-down"></i></button><span>Fragments</span><button data-column-sort="narrator">Teicējs <i data-lucide="arrow-up-down"></i></button><button data-column-sort="collector">Pierakstītājs <i data-lucide="arrow-up-down"></i></button><button data-column-sort="place">Vieta <i data-lucide="arrow-up-down"></i></button><button data-column-sort="year">Gads <i data-lucide="arrow-up-down"></i></button></div>
      <ol class="results-list" data-results></ol><div class="empty" data-empty hidden><strong>Nekas netika atrasts.</strong><br/>Mainiet meklējamo vārdu vai filtrus.</div><div class="pagination-row"><nav class="pagination" aria-label="Rezultātu lapas" data-pagination></nav><label class="page-jump">Doties uz <input type="number" min="1" inputmode="numeric" placeholder="lpp." data-page-jump /></label><div class="page-size"><span data-i18n="browser.perPage">Rādīt lappusē</span><details class="page-size-menu" data-page-size-menu><summary><span data-page-size-label>20</span><i data-lucide="chevron-down"></i></summary><div class="page-size-options"><button type="button" data-page-size="20" aria-pressed="true"><i data-lucide="check"></i><span>20</span></button><button type="button" data-page-size="50" aria-pressed="false"><i data-lucide="check"></i><span>50</span></button><button type="button" data-page-size="100" aria-pressed="false"><i data-lucide="check"></i><span>100</span></button></div></details></div></div>
    </div>
  </section>
  <script type="application/json" id="browse-data" is:inline set:html={JSON.stringify(browseRecords).replace(/</g,'\\u003c')} />
  <script>
    type R={id:string;volume:string;chapterLv:string;chapterDe:string;titleLv:string;titleDe:string;place:string;collector:string;narrator:string;year:string;excerptLv:string;excerptDe:string};
    const root=document.querySelector<HTMLElement>('[data-browser]')!,data=JSON.parse(document.querySelector('#browse-data')!.textContent||'[]') as R[];
    const q=root.querySelector<HTMLInputElement>('#q')!,searchHelp=root.querySelector<HTMLElement>('#search-help')!,yearFrom=root.querySelector<HTMLInputElement>('#year-from')!,yearTo=root.querySelector<HTMLInputElement>('#year-to')!,includeUndated=root.querySelector<HTMLInputElement>('#include-undated')!,includeUnknownNarrator=root.querySelector<HTMLInputElement>('#include-unknown-narrator')!,includeUnknownCollector=root.querySelector<HTMLInputElement>('#include-unknown-collector')!,includeUnknownPlace=root.querySelector<HTMLInputElement>('#include-unknown-place')!,timeline=yearFrom.closest<HTMLElement>('.timeline')!;
    const list=root.querySelector<HTMLOListElement>('[data-results]')!,count=root.querySelector<HTMLElement>('[data-count]')!,empty=root.querySelector<HTMLElement>('[data-empty]')!,pages=root.querySelector<HTMLElement>('[data-pagination]')!,pageLabel=root.querySelector<HTMLElement>('[data-page-label]')!,listHead=root.querySelector<HTMLElement>('[data-list-head]')!,cardSort=root.querySelector<HTMLSelectElement>('[data-card-sort]')!,cardSortWrap=cardSort.closest<HTMLElement>('.card-sort')!,activeFilters=root.querySelector<HTMLElement>('[data-active-filters]')!,clearButton=root.querySelector<HTMLButtonElement>('[data-clear]')!,clearPinsButton=root.querySelector<HTMLButtonElement>('[data-clear-pins]')!,mobileFilterToggle=root.querySelector<HTMLButtonElement>('[data-mobile-filter-toggle]')!,filterSidebar=root.querySelector<HTMLElement>('.filter-sidebar')!;
    const openPinsButton=document.createElement('button');openPinsButton.type='button';openPinsButton.className='clear-pins open-pins';openPinsButton.innerHTML='<i data-lucide="external-link"></i><span></span>';clearPinsButton.insertAdjacentElement('afterend',openPinsButton);
    const copySelectionButton=document.createElement('button');copySelectionButton.type='button';copySelectionButton.className='clear-pins copy-selection-link';copySelectionButton.innerHTML='<i data-lucide="link"></i><span></span>';openPinsButton.insertAdjacentElement('afterend',copySelectionButton);
    const downloadMenu=document.createElement('details');downloadMenu.className='download-menu';downloadMenu.innerHTML='<summary><i data-lucide="download"></i><span></span><i data-lucide="chevron-down"></i></summary><div class="download-options"><fieldset class="download-citation"><legend></legend><label><input type="radio" name="download-citation" value="clarin" checked><span>CLARIN-LV</span></label><label><input type="radio" name="download-citation" value="site"><span>Teikas</span></label></fieldset><div class="download-formats"><button type="button" data-download-format="csv">CSV</button><button type="button" data-download-format="txt">TXT</button><button type="button" data-download-format="json">JSON</button></div></div>';filterSidebar.append(downloadMenu);const downloadHint=document.createElement('p');downloadHint.className='download-hint';downloadMenu.insertAdjacentElement('afterend',downloadHint);
    type SearchText={lv:string;de:string};type MultiType='theme'|'narrator'|'collector'|'place'|'volume';const selectedThemes=new Set<string>(),selectedNarrators=new Set<string>(),selectedCollectors=new Set<string>(),selectedPlaces=new Set<string>(),selectedVolumes=new Set<string>(),selections:Record<MultiType,Set<string>>={theme:selectedThemes,narrator:selectedNarrators,collector:selectedCollectors,place:selectedPlaces,volume:selectedVolumes},pins=new Set<string>(JSON.parse(localStorage.getItem('teikas-pins')||'[]')),expandedIds=new Set<string>(),seed=Math.random();let page=1,size=20,view=localStorage.getItem('teikas-browse-view')||'list',sortKey='random',sortDirection=1,searchIndex:Map<string,SearchText>|null=null,token=0,activeTerms:string[]=[],activeTermLabels:string[]=[];
    const tr=(key:string,values:Record<string,string|number>={})=>(window as any).teikasT?.(key,values)||key;const syncDownloadAvailability=(resultCount:number)=>{const available=resultCount>0&&resultCount<data.length;downloadMenu.dataset.disabled=String(!available);downloadMenu.querySelector('summary')!.setAttribute('aria-disabled',String(!available));downloadMenu.querySelectorAll<HTMLButtonElement>('[data-download-format]').forEach(button=>button.disabled=!available);downloadHint.hidden=available;downloadHint.textContent=tr('browser.downloadHint');if(!available)downloadMenu.open=false};downloadMenu.querySelector('summary')!.addEventListener('click',event=>{if(downloadMenu.dataset.disabled==='true')event.preventDefault()});new MutationObserver(()=>syncDownloadAvailability(Number((count.textContent||'').replace(/\D/g,''))||0)).observe(count,{childList:true,characterData:true,subtree:true});window.addEventListener('ui-language-change',()=>{downloadHint.textContent=tr('browser.downloadHint')});
    const resultCountLabel=root.querySelector<HTMLElement>('[data-result-count-label]')!;const decorateReadActions=()=>{list.querySelectorAll<HTMLAnchorElement>('.read-full:not([data-primary-read])').forEach(link=>{link.dataset.primaryRead='';const actions=document.createElement('div');actions.className='card-read-actions';const openNew=document.createElement('a');openNew.className='read-full open-new';openNew.href=link.href;openNew.target='_blank';openNew.rel='noopener';openNew.innerHTML=`<span>${tr('browser.openNewWindow')}</span><i data-lucide="external-link"></i>`;link.before(actions);actions.append(link,openNew)});refreshIcons()};const syncResultCountLabel=()=>{const nodes=resultCountLabel.childNodes;nodes[0].textContent=`${list.children.length} ${tr('browser.resultsOf')} `;nodes[nodes.length-1].textContent=` ${tr('browser.resultsNoun')}`;decorateReadActions()};new MutationObserver(syncResultCountLabel).observe(list,{childList:true});window.addEventListener('ui-language-change',()=>{syncResultCountLabel();list.querySelectorAll<HTMLElement>('.open-new span').forEach(label=>label.textContent=tr('browser.openNewWindow'))});
    const esc=(s:string)=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]!)),fold=(s:string)=>s.toLocaleLowerCase('lv').normalize('NFD').replace(/[\u0300-\u036f]/g,''),searchNorm=(s:string)=>fold(s).replace(/\s+/g,' ').trim(),parseRawTerms=(value:string)=>{const terms:string[]=[];for(const match of value.matchAll(/"([^"]+)"|“([^”]+)”|(\S+)/g)){const term=(match[1]||match[2]||match[3]||'').replace(/\s+/g,' ').trim();if(term&&!terms.some(item=>searchNorm(item)===searchNorm(term)))terms.push(term)}return terms};const mode=()=>document.documentElement.dataset.contentMode||'parallel';const hash=(s:string)=>{let h=2166136261;for(const c of s)h=Math.imul(h^c.charCodeAt(0),16777619);return(h>>>0)/4294967296};
    const base=import.meta.env.BASE_URL;
    const selectionParams=new URLSearchParams(location.search),sharedSelection=new Set((selectionParams.get('selection')||'').split(',').map(id=>id.trim()).filter(Boolean)),selectionOnly=sharedSelection.size>0,pinnedOnly=selectionParams.get('pinned')==='1';
    async function ensureSearch(){if(searchIndex)return searchIndex;const rows=await(await fetch(`${base}search-index.json?v=2`)).json() as ({id:string}&SearchText)[];return searchIndex=new Map(rows.map(r=>[r.id,{lv:r.lv||'',de:r.de||''}]))}
    function title(r:R){return mode()==='lv'?marked(r.titleLv||'Bez nosaukuma',activeTerms):mode()==='de'?`<span lang="de">${marked(r.titleDe||'Ohne Titel',activeTerms)}</span>`:`${marked(r.titleLv||'Bez nosaukuma',activeTerms)}<small lang="de">${marked(r.titleDe||'Nav norādīts',activeTerms)}</small>`}
    function marked(value:string,terms:string[]){if(!terms.length)return esc(value);let normalized='',starts:number[]=[],ends:number[]=[];for(let i=0;i<value.length;){const char=String.fromCodePoint(value.codePointAt(i)!),next=i+char.length,part=fold(char);for(const unit of part){normalized+=unit;starts.push(i);ends.push(next)}i=next}const ranges:[number,number][]=[];for(const term of terms){let from=0,at=-1;while((at=normalized.indexOf(term,from))>=0){ranges.push([starts[at],ends[at+term.length-1]]);from=at+Math.max(1,term.length)}}if(!ranges.length)return esc(value);ranges.sort((a,b)=>a[0]-b[0]);const merged=ranges.reduce<[number,number][]>((all,range)=>{const last=all.at(-1);if(last&&range[0]<=last[1])last[1]=Math.max(last[1],range[1]);else all.push([...range]);return all},[]);let html='',cursor=0;for(const [start,end] of merged){html+=esc(value.slice(cursor,start))+`<mark>${esc(value.slice(start,end))}</mark>`;cursor=end}return html+esc(value.slice(cursor))}function contextual(value:string,terms:string[],fallback:string,expanded=false,limitOverride?:number){const clean=(value||fallback).replace(/\s+/g,' ').trim(),limit=limitOverride??(expanded?900:260),folded=fold(clean),term=terms.find(item=>folded.includes(item))||'';if(!term)return clean.slice(0,limit)+(clean.length>limit?'…':'');const at=folded.indexOf(term),before=Math.min(expanded?260:90,Math.round(limit*.38)),after=Math.max(50,limit-before-term.length);let start=Math.max(0,at-before),end=Math.min(clean.length,at+term.length+after);if(start){const space=clean.indexOf(' ',start);start=space<0?start:space+1}if(end<clean.length){const space=clean.lastIndexOf(' ',end);end=space<0?end:space}return`${start?'…':''}${clean.slice(start,end)}${end<clean.length?'…':''}`}function excerpt(r:R,expanded=false){const full=searchIndex?.get(r.id),lvText=full?.lv||'',deText=full?.de||'',parallel=mode()==='parallel',parallelLimit=parallel&&view==='list'?(expanded?380:145):undefined,lv=contextual(lvText,activeTerms,r.excerptLv
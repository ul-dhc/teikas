    async function animateReorder(goToFirstPage=false){const before=new Map<string,number>();list.querySelectorAll<HTMLElement>('.result-card[data-id]').forEach(item=>before.set(item.dataset.id!,item.getBoundingClientRect().top));if(goToFirstPage)page=1;await render();if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;const animations:Animation[]=[];list.querySelectorAll<HTMLElement>('.result-card[data-id]').forEach(item=>{const oldTop=before.get(item.dataset.id!);if(oldTop===undefined)return;const delta=oldTop-item.getBoundingClientRect().top;if(Math.abs(delta)>1)animations.push(item.animate([{transform:`translateY(${delta}px)`},{transform:'translateY(0)'}],{duration:680,easing:'cubic-bezier(.22,.75,.2,1)'}))});await Promise.allSettled(animations.map(animation=>animation.finished))}
    list.addEventListener('click',event=>{const pin=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-pin]');if(!pin)return;event.preventDefault();event.stopImmediatePropagation();const id=pin.dataset.pin!,card=pin.closest<HTMLElement>('.result-card')!,willPin=!pins.has(id);willPin?pins.add(id):pins.delete(id);localStorage.setItem('teikas-pins',JSON.stringify([...pins]));pin.setAttribute('aria-pressed',String(willPin));pin.setAttribute('aria-label',`${willPin?'Atspraust':'Piespraust'} teiku`);card.classList.toggle('is-pinned',willPin);clearPinsButton.hidden=!pins.size;pin.disabled=true;window.setTimeout(()=>animateReorder(),360)},true);
    const undatedLabel=root.querySelector<HTMLElement>('.undated-toggle small'),undatedValues=undatedLabel?.textContent?.match(/(\d+)%.*?(\d+)/);const translateUndated=()=>{if(undatedLabel&&undatedValues)undatedLabel.textContent=tr('filters.undatedCount',{percent:undatedValues[1],count:Number(undatedValues[2]).toLocaleString(document.documentElement.lang)})};window.addEventListener('ui-language-change',translateUndated);translateUndated();
    window.addEventListener('content-mode-change',(event)=>setMode((event as CustomEvent).detail));

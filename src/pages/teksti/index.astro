    function item(r:R){const pinned=pins.has(r.id),expanded=expandedIds.has(r.id),href=`${base}teksti/${r.id}/`,whereWhen=[r.place,r.year].filter(Boolean).join(', '),personMeta=(label:string,value:string)=>value?`<span class="person-meta"><span class="meta-label">${label}:</span> <span class="meta-value">${marked(value.replace(/[.\s]+$/,''),activeTerms)}.</span></span>`:'',people=[personMeta(tr('meta.narrator'),r.narrator),personMeta(tr('meta.collector'),r.collector)].filter(Boolean).join(' '),parallel=mode()==='parallel';return `<li class="result-card${pinned?' is-pinned':''}${expanded?' is-expanded':''}" data-id="${r.id}" data-href="${href}" tabindex="0" aria-expanded="${expanded}" aria-label="${tr(expanded?'browser.collapse':'browser.expand')}: ${esc(r.titleLv||r.id)}"><button class="pin-button" data-pin="${r.id}" aria-pressed="${pinned}" aria-label="${tr(pinned?'browser.unpin':'browser.pin')}"><i data-lucide="pin"></i></button><div class="result-id">${marked(r.id,activeTerms)}</div><h2><a href="${href}" data-title-link>${title(r)}</a></h2><div class="result-excerpt${parallel?' is-parallel':''}">${excerpt(r,expanded)}</div><div class="result-narrator${r.narrator?'':' is-empty'}">${marked(r.narrator||'—',activeTerms)}</div><div class="result-collector${r.collector?'':' is-empty'}">${marked(r.collector||'—',activeTerms)}</div><div class="result-place${r.place?'':' is-empty'}">${marked(r.place||'—',activeTerms)}</div><div class="result-year${r.year?'':' is-empty'}">${marked(r.year||'—',activeTerms)}</div>${whereWhen?`<div class="card-location">${marked(whereWhen,activeTerms)}</div>`:''}${people?`<div class="card-people">${people}</div>`:''}<a class="read-full" href="${href}">${tr('browser.readAll')} <i data-lucide="arrow-right"></i></a></li>`}
    function sortValue(r:R){if(sortKey==='id')return r.id;if(sortKey==='title')return mode()==='de'?r.titleDe:r.titleLv;if(sortKey==='narrator')return r.narrator;if(sortKey==='collector')return r.collector;if(sortKey==='place')return r.place;if(sortKey.startsWith('year'))return r.year;return hash(r.id+seed)}

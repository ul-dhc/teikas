---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/admin-stats.css';
const endpoint=import.meta.env.PUBLIC_FEEDBACK_ENDPOINT||'https://script.google.com/macros/s/AKfycbwoy8tBpCzcFiAGIB3u_fSxQbgjH0M00PBcG9DjOe98XaZizH2dqFbqPr0kVtQPR2-enQ/exec';
---
<BaseLayout title="Platformas statistika" description="TEIKAS komandas statistika un iesniegumu pārskats." noindex>
 <section class="section shell admin-stats" data-admin-stats data-endpoint={endpoint} data-i18n-skip>
  <h1 data-stat-copy="title">Platformas statistika</h1>
  <form class="stats-login" data-stats-login>
   <label class="field"><span data-stat-copy="password">Parole</span><input type="password" name="password" required maxlength="256" autocomplete="current-password" /></label>
   <button class="button" type="submit" data-stat-copy="signIn">Atvērt statistiku</button>
  </form>
  <p class="search-help" data-stats-status role="status" aria-live="polite"></p>
  <div data-stats-workspace hidden>
   <div class="browser-toolbar">
    <div class="view-switch" role="tablist" data-stats-tabs>
     <button type="button" role="tab" id="visits-tab" aria-controls="visits-panel" aria-selected="true" aria-pressed="true" data-stats-tab="visits" data-stat-copy="visits">Apmeklējumi</button>
     <button type="button" role="tab" id="reports-tab" aria-controls="reports-panel" aria-selected="false" aria-pressed="false" tabindex="-1" data-stats-tab="reports" data-stat-copy="reports">Kļūdas un ierosinājumi</button>
    </div>
    <div class="view-tools">
     <details class="sort-menu" data-stats-period-menu><summary><span data-stats-period-label></span><i data-lucide="chevron-down" aria-hidden="true"></i></summary><div class="sort-menu-options">{[0,7,30,90,365].map(days=><button type="button" data-stats-days={days} aria-pressed={days===7?'true':'false'}><i data-lucide="check" aria-hidden="true"></i><span data-stat-copy={`days${days}`}></span></button>)}</div></details>
     <button class="text-button icon-link" type="button" data-stats-refresh><i data-lucide="rotate-ccw" aria-hidden="true"></i><span data-stat-copy="refresh">Atjaunot</span></button>
     <button class="text-button" type="button" data-stats-logout data-stat-copy="signOut">Iziet</button>
    </div>
   </div>
   <section class="stats admin-stats-summary">
    <div class="stat"><i data-lucide="chart-no-axes-column" aria-hidden="true"></i><strong data-stats-total>—</strong><span data-stat-copy="visits">Apmeklējumi</span></div>
    <div class="stat"><i data-lucide="file-stack" aria-hidden="true"></i><strong data-stats-pages>—</strong><span data-stat-copy="visitedPages">Apmeklētās lapas</span></div>
    <div class="stat"><i data-lucide="circle-alert" aria-hidden="true"></i><strong data-stats-report-count>—</strong><span data-stat-copy="reports">Kļūdas un ierosinājumi</span></div>
   </section>
   <p class="search-help" data-stats-freshness></p>
   <section role="tabpanel" id="visits-panel" aria-labelledby="visits-tab">
    <p class="search-help" data-stat-copy="scope">Tikai TEIKAS lapas zem /teikas/. Avots: GoatCounter.</p>
    <p class="search-help" data-stats-visits-status role="status"></p>
    <article class="stats-panel"><h2 data-stat-copy="daily">Apmeklējumi pa dienām</h2><div data-stats-chart></div><label class="field"><span class="sr-only" data-stat-copy="day">Diena</span><input type="range" min="0" max="6" value="6" data-stats-day /></label><p data-stats-day-label></p></article>
    <article class="stats-panel"><h2 data-stat-copy="sections">Apmeklējumi pa sadaļām</h2><div data-stats-sections></div></article>
    <article class="stats-panel"><h2 data-stat-copy="popular">Apmeklētākās lapas</h2><div data-stats-popular></div></article>
    <p class="search-help" data-stat-copy="countNote">Apmeklējumi nav unikālu cilvēku skaits. Uzskaite aptver laiku, kad lapās darbojas GoatCounter.</p>
   </section>
   <section role="tabpanel" id="reports-panel" aria-labelledby="reports-tab" hidden>
    <label class="field"><span data-stat-copy="searchReports">Meklēt iesniegumos</span><input type="search" data-stats-report-search /></label>
    <p class="search-help" data-stats-report-note></p><div class="stats-reports" data-stats-reports></div>
   </section>
  </div>
 </section>
 <script>import '../../scripts/admin-stats';</script>
</BaseLayout>

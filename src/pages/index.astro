---
import BaseLayout from '../layouts/BaseLayout.astro';
import { legends, dailyLegends, collectors, narrators, places, resolveLegend, legendYear, displayPersonName } from '../lib/data';
import homeMap from '../data/home-map.json';
const base = import.meta.env.BASE_URL;
const todayParts = new Intl.DateTimeFormat('lv-LV', { timeZone: 'Europe/Riga', day: '2-digit', month: '2-digit', year: 'numeric' }).formatToParts(new Date());
const todayPart = (type: Intl.DateTimeFormatPartTypes) => todayParts.find(part => part.type === type)?.value ?? '';
const today = `${todayPart('day')}.${todayPart('month')}.${todayPart('year')}`;
const dayNumber = Math.floor(Date.UTC(Number(todayPart('year')), Number(todayPart('month')) - 1, Number(todayPart('day'))) / 86400000);
const daily = dailyLegends[dayNumber % dailyLegends.length];
const dailyExcerpt = (daily.text.lv ?? '').replace(/\s+/g,' ').slice(0,520).trimEnd() + ((daily.text.lv?.length ?? 0)>520?'…':'');
const dailyExcerptDe = (daily.text.de ?? '').replace(/\s+/g,' ').slice(0,520).trimEnd() + ((daily.text.de?.length ?? 0)>520?'…':'');
const dailyData = resolveLegend(daily);
const dailyYear = legendYear(daily);
const dailyPlaceYear = [dailyData.place?.name, dailyYear].filter(Boolean).join(', ');
const dailyNarrator = displayPersonName(dailyData.narrator), dailyCollector = displayPersonName(dailyData.collector);
const dailyAttribution = [dailyPlaceYear ? `${dailyPlaceYear}.` : '', dailyNarrator ? `Stāstīja: ${dailyNarrator.replace(/[.\s]+$/,'')}.` : '', dailyCollector ? `Pierakstīja: ${dailyCollector.replace(/[.\s]+$/,'')}.` : ''].filter(Boolean).join(' ');
const dailyPublicUrl = new URL(`${base}teksti/${daily.id}/`, Astro.site ?? Astro.url.origin).href;
const dailyShareText = [`Dienas teika. ${today}.`, daily.title.lv || 'Bez nosaukuma', dailyExcerpt || 'Teksts nav norādīts.', dailyAttribution, dailyPublicUrl].filter(Boolean).join('\n\n');
---
<BaseLayout active="home">
  <section class="hero"><div class="home-map is-arriving" aria-hidden="true"><svg viewBox={`0 0 ${homeMap.width} ${homeMap.height}`} preserveAspectRatio="xMidYMid meet"><g class="legend-points">{homeMap.points.map((point,index)=><circle cx={point.x} cy={point.y} r={Math.min(11,1.25+Math.sqrt(point.count)*.48)} data-legend-count={point.count} class:list={[index%3===0?'point-green':'point-blue']}/>)}</g></svg></div><div class="shell"><p class="development-notice" role="status"><i data-lucide="info" aria-hidden="true"></i><span data-i18n="home.developmentNotice">Šis resurss šobrīd ir izstrādes procesā.</span></p><h1 class="display">Teikas</h1><p class="lede">Latviešu tautas teikas, ko apkopojis Pēteris Šmits “Latviešu pasaku un teiku” (1925–1937) 13.–15. sējumā.</p><form class="hero-search" action={`${base}teksti/`} method="get"><label class="sr-only" for="home-search">Meklēt kolekcijā</label><input id="home-search" name="q" type="search" placeholder="Meklēt pēc atslēgvārda, teicēja vārda vai vietas…" /><button class="button primary" type="submit">Meklēt</button></form><div class="hero-actions"><a class="button icon-link" href={`${base}teksti/`}>Atvērt teiku pārlūku <i data-lucide="arrow-right"></i></a></div></div></section>
  <section class="shell stats" aria-label="Kolekcijas statistika"><div class="stat"><i data-lucide="file-stack"></i><strong data-count-up={legends.length}>{legends.length.toLocaleString('lv-LV')}</strong><span>teikas</span></div><div class="stat"><i data-lucide="notebook-pen"></i><strong data-count-up={collectors.length}>{collectors.length.toLocaleString('lv-LV')}</strong><span>pierakstītāji</span></div><div class="stat"><i data-lucide="users-round"></i><strong data-count-up={narrators.length}>{narrators.length.toLocaleString('lv-LV')}</strong><span>teicēji</span></div><div class="stat"><i data-lucide="map-pin"></i><strong data-count-up={places.length}>{places.length.toLocaleString('lv-LV')}</strong><span>vietas</span></div></section>
  <section class="section shell daily-section"><div class="daily-icon" aria-label={`Šodien, ${today}`}><span class="calendar-mark"><i data-lucide="calendar-days"></i></span><span class="calendar-label">Šodien</span><time datetime={`${todayPart('year')}-${todayPart('month')}-${todayPart('day')}`}>{today}</time></div><article class="daily-legend"><div class="daily-heading"><div class="eyebrow">Dienas teika</div><div class="daily-nav" aria-label="Dienas teiku navigācija"><button type="button" data-daily-prev aria-label="Iepriekšējā diena" title="Iepriekšējā diena"><i data-lucide="arrow-left"></i></button><button type="button" data-daily-today aria-label="Atgriezties šodienā" title="Atgriezties šodienā"><i data-lucide="calendar-clock"></i></button><button type="button" data-daily-next aria-label="Nākamā diena" title="Nākamā diena"><i data-lucide="arrow-right"></i></button></div><button class="daily-copy" type="button" data-daily-copy={dailyShareText} aria-label="Kopēt dienas teiku" title="Kopēt dienas teiku"><i data-copy-icon data-lucide="copy"></i><span data-copy-status aria-live="polite"></span></button></div><h2><a data-daily-title href={`${base}teksti/${daily.id}/`}>{daily.title.lv || 'Bez nosaukuma'}</a></h2><p class="daily-excerpt">{dailyExcerpt || 'Teksts nav norādīts.'}</p>{dailyAttribution && <p class="daily-attribution">{dailyAttribution}</p>}<a class="button icon-link" data-daily-link href={`${base}teksti/${daily.id}/`}>Lasīt teiku <i data-lucide="arrow-right"></i></a></article></section>
  <script define:vars={{dailyTitleLv: daily.title.lv || 'Bez nosaukuma', dailyTitleDe: daily.title.de || 'Ohne Titel', dailyExcerptLv: dailyExcerpt || 'Teksts nav norādīts.', dailyExcerptDe: dailyExcerptDe || 'Text nicht angegeben.', dailyAttributionValue: dailyAttribution, todayValue: today, initialDayNumber: dayNumber, legendCount: dailyLegends.length, baseUrl: base}}>
    let dailyState={titleLv:dailyTitleLv,titleDe:dailyTitleDe,excerptLv:dailyExcerptLv,excerptDe:dailyExcerptDe,attribution:dailyAttributionValue,date:todayValue};
    let selectedDayNumber=initialDayNumber,knownTodayDayNumber=initialDayNumber;
    const dailyElements=()=>({title:document.querySelector('[data-daily-title]'),text:document.querySelector('.daily-excerpt'),attribution:document.querySelector('.daily-attribution'),date:document.querySelector('.daily-icon time'),label:document.querySelector('.daily-icon .calendar-label'),icon:document.querySelector('.daily-icon'),previous:document.querySelector('[data-daily-prev]'),today:document.querySelector('[data-daily-today]'),next:document.querySelector('[data-daily-next]')});
    const showDailyLanguage=(lang)=>{const german=lang==='de',elements=dailyElements(),isToday=selectedDayNumber===knownTodayDayNumber;if(elements.title)elements.title.textContent=german?dailyState.titleDe||'Ohne Titel':dailyState.titleLv||'Bez nosaukuma';if(elements.text)elements.text.textContent=german?dailyState.excerptDe||'Text nicht angegeben.':dailyState.excerptLv||'Teksts nav norādīts.';if(elements.attribution)elements.attribution.textContent=dailyState.attribution;if(elements.date)elements.date.textContent=dailyState.date+(lang==='lv'?'.':'');if(elements.label)elements.label.textContent=isToday?(german?'Heute':'Šodien'):(german?'Tageslegende':'Dienas teika')};
    const rigaToday=()=>{const parts=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Riga',year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date()),part=type=>parts.find(item=>item.type===type)?.value||'';return{year:part('year'),month:part('month'),day:part('day')}};
    const dayParts=number=>{const date=new Date(number*86400000);return{year:String(date.getUTCFullYear()),month:String(date.getUTCMonth()+1).padStart(2,'0'),day:String(date.getUTCDate()).padStart(2,'0')}};
    const syncDailyControls=()=>{const elements=dailyElements(),isToday=selectedDayNumber===knownTodayDayNumber;if(elements.next)elements.next.disabled=isToday;if(elements.today)elements.today.disabled=isToday};
    const loadDaily=async dayNumber=>{if(dayNumber>knownTodayDayNumber)return;const current=dayParts(dayNumber),date=`${current.day}.${current.month}.${current.year}`,index=((dayNumber%legendCount)+legendCount)%legendCount;if(dayNumber===selectedDayNumber&&date===dailyState.date){syncDailyControls();return}try{const response=await fetch(`${baseUrl}daily/${index}.json`);if(!response.ok)return;const record=await response.json(),href=`${baseUrl}teksti/${record.id}/`,placeYear=[record.place,record.year].filter(Boolean).join(', '),attribution=[placeYear?`${placeYear}.`:'',record.narrator?`Stāstīja: ${record.narrator.replace(/[.\s]+$/,'')}.`:'',record.collector?`Pierakstīja: ${record.collector.replace(/[.\s]+$/,'')}.`:''].filter(Boolean).join(' ');selectedDayNumber=dayNumber;dailyState={titleLv:record.titleLv,titleDe:record.titleDe,excerptLv:record.excerptLv,excerptDe:record.excerptDe,attribution,date};document.querySelectorAll('[data-daily-title],[data-daily-link]').forEach(link=>link.href=href);const elements=dailyElements();if(elements.date)elements.date.dateTime=`${current.year}-${current.month}-${current.day}`;if(elements.icon)elements.icon.setAttribute('aria-label',`${date}`);const copy=document.querySelector('[data-daily-copy]');if(copy)copy.dataset.dailyCopy=[`Dienas teika. ${date}.`,record.titleLv||'Bez nosaukuma',record.excerptLv||'Teksts nav norādīts.',attribution,new URL(href,location.origin).href].filter(Boolean).join('\n\n');showDailyLanguage(document.documentElement.dataset.uiLang);syncDailyControls()}catch{}};
    const refreshDaily=()=>{const current=rigaToday(),todayNumber=Math.floor(Date.UTC(Number(current.year),Number(current.month)-1,Number(current.day))/86400000),wasToday=selectedDayNumber===knownTodayDayNumber;knownTodayDayNumber=todayNumber;if(wasToday)loadDaily(todayNumber);else{showDailyLanguage(document.documentElement.dataset.uiLang);syncDailyControls()}};
    dailyElements().previous?.addEventListener('click',()=>loadDaily(selectedDayNumber-1));dailyElements().next?.addEventListener('click',()=>loadDaily(selectedDayNumber+1));dailyElements().today?.addEventListener('click',()=>loadDaily(knownTodayDayNumber));window.addEventListener('ui-language-change',event=>showDailyLanguage(event.detail));showDailyLanguage(document.documentElement.dataset.uiLang);refreshDaily();setInterval(refreshDaily,60000);
  </script>
  <script>
    const counters=[...document.querySelectorAll<HTMLElement>('[data-count-up]')];
    const reducedMotion=matchMedia('(prefers-reduced-motion: reduce)').matches;
    const formatter=new Intl.NumberFormat('lv-LV');
    function animateCounter(counter:HTMLElement){const target=Number(counter.dataset.countUp);if(!Number.isFinite(target)||counter.dataset.animated)return;counter.dataset.animated='true';if(reducedMotion){counter.textContent=formatter.format(target);return}counter.textContent='0';const duration=2400,start=performance.now();function frame(now:number){const progress=Math.min(1,(now-start)/duration),eased=1-Math.pow(1-progress,3);counter.textContent=formatter.format(Math.round(target*eased));if(progress<1)requestAnimationFrame(frame)}requestAnimationFrame(frame)}
    if('IntersectionObserver' in window){const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){animateCounter(entry.target as HTMLElement);observer.unobserve(entry.target)}}),{threshold:.45});counters.forEach(counter=>observer.observe(counter))}else counters.forEach(animateCounter);
    const map=document.querySelector<HTMLElement>('.home-map');
    if(map){const svg=map.querySelector<SVGSVGElement>('svg'),dots=[...map.querySelectorAll<SVGCircleElement>('.legend-points circle')];if(reducedMotion||!matchMedia('(min-width:1100px)').matches)map.classList.remove('is-arriving');else{dots.forEach((dot,index)=>{const yellowAccent=index%13===2;const delay=yellowAccent?25+(index%5)*24:((index*37)%40)*22;dot.style.setProperty('--intro-delay',`${delay}ms`)});setTimeout(()=>{map.classList.remove('is-arriving');map.classList.add('is-settling');setTimeout(()=>map.classList.remove('is-settling'),2800)},1450)}if(svg&&matchMedia('(pointer:fine)').matches){let pointerX=0,pointerY=0,proximityFrame=0;const active=new Set<SVGCircleElement>(),clearProximity=()=>{active.forEach(dot=>{dot.classList.remove('is-near');dot.style.removeProperty('--proximity')});active.clear()};const updateProximity=()=>{proximityFrame=0;const matrix=svg.getScreenCTM();if(!matrix)return;const point=new DOMPoint(pointerX,pointerY).matrixTransform(matrix.inverse()),radius=112,next=new Set<SVGCircleElement>();dots.forEach(dot=>{const distance=Math.hypot(Number(dot.getAttribute('cx'))-point.x,Number(dot.getAttribute('cy'))-point.y);if(distance>=radius)return;const strength=1-distance/radius;dot.style.setProperty('--proximity',strength.toFixed(3));dot.classList.add('is-near');next.add(dot)});active.forEach(dot=>{if(next.has(dot))return;dot.classList.remove('is-near');dot.style.removeProperty('--proximity')});active.clear();next.forEach(dot=>active.add(dot))};map.addEventListener('pointermove',event=>{pointerX=event.clientX;pointerY=event.clientY;if(!proximityFrame)proximityFrame=requestAnimationFrame(updateProximity)},{passive:true});map.addEventListener('pointerleave',()=>{if(proximityFrame)cancelAnimationFrame(proximityFrame);proximityFrame=0;clearProximity()})}}
    const dailyCopy=document.querySelector<HTMLButtonElement>('[data-daily-copy]');
    dailyCopy?.addEventListener('click',async()=>{const text=dailyCopy.dataset.dailyCopy||'';try{await navigator.clipboard.writeText(text)}catch{const area=document.createElement('textarea');area.value=text;area.style.position='fixed';area.style.opacity='0';document.body.append(area);area.select();document.execCommand('copy');area.remove()}const icon=dailyCopy.querySelector<HTMLElement>('[data-copy-icon]')!,status=dailyCopy.querySelector<HTMLElement>('[data-copy-status]')!;icon.dataset.lucide='check';status.textContent='Nokopēts';dailyCopy.classList.add('copied');(window as any).renderLucideIcons?.();setTimeout(()=>{icon.dataset.lucide='copy';status.textContent='';dailyCopy.classList.remove('copied');(window as any).renderLucideIcons?.()},1800)});
  </script>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { legends, resolveLegend, sourceLabel, legendYear, displayPersonName, type Legend } from '../../lib/data';
export function getStaticPaths() { return legends.map((legend, index) => ({ params: { id: legend.id }, props: { legend, index } })); }
const { legend, index } = Astro.props as { legend: Legend; index: number };
const data = resolveLegend(legend), previous = legends[index - 1], next = legends[index + 1], year = legendYear(legend);
const basicRows = [['ID', legend.id], ['Vieta', data.place?.name || 'Nav norādīts'], ['Teicējs', displayPersonName(data.narrator) || '—'], ['Pierakstītājs', displayPersonName(data.collector) || '—'], ['Gads', year || 'Nav norādīts']];
const allSources = [...data.primarySources, ...data.secondarySources];
const hasSources = allSources.length > 0 || Boolean(legend.primarySourceRaw || legend.secondarySourceRaw);
const publicUrl = `https://dhc.lu.lv/teikas/${legend.id}/`;
const narratorName = displayPersonName(data.narrator), collectorName = displayPersonName(data.collector);
const shareMetadata = [
  `ID: ${legend.id}.`,
  data.place?.name ? `Vieta: ${data.place.name}.` : '',
  year ? `Gads: ${year}.` : '',
  narratorName ? `Stāstīja: ${narratorName.replace(/[.\s]+$/,'')}.` : '',
  collectorName ? `Pierakstīja: ${collectorName.replace(/[.\s]+$/,'')}.` : '',
].filter(Boolean).join(' ');
const lvShareText = [legend.title.lv || 'Bez nosaukuma', legend.text.lv || 'Teksts nav norādīts.', shareMetadata, publicUrl].join('\n\n');
const deShareText = [legend.title.de || 'Ohne Titel', legend.text.de || 'Text nicht angegeben.', shareMetadata, publicUrl].join('\n\n');
const parallelShareText = [legend.title.lv || 'Bez nosaukuma', 'Latviski', legend.text.lv || 'Teksts nav norādīts.', legend.title.de || 'Ohne Titel', 'Deutsch', legend.text.de || 'Text nicht angegeben.', shareMetadata, publicUrl].join('\n\n');
---
<BaseLayout title={legend.title.lv || legend.id} active="browse">
  <article class="detail">
    <div class="detail-top"><a class="back-link icon-link" href="/teikas/" data-back><i data-lucide="arrow-left"></i> Atpakaļ</a><button class="copy-icon" type="button" data-copy data-copy-lv={lvShareText} data-copy-de={deShareText} data-copy-parallel={parallelShareText} aria-label="Kopēt teiku" title="Kopēt teiku"><i data-lucide="copy"></i></button></div>
    <header class="title-row"><div><h1 data-title-lang="lv">{legend.title.lv || 'Bez nosaukuma'}</h1><h1 data-title-lang="de" lang="de">{legend.title.de || 'Ohne Titel'}</h1></div></header>
    <div class="mode-tabs" role="tablist" aria-label="Šīs teikas valodas skats"><button role="tab" data-mode="lv">Latviski</button><button role="tab" data-mode="de">Deutsch</button><button role="tab" data-mode="parallel">Paralēli</button></div>
    <div class="detail-grid">
      <div class="reading-column">
        <div class="texts" data-texts><section class="text-panel" data-lang="lv" aria-labelledby="lv-heading"><h2 id="lv-heading">LATVISKI</h2><div class="legend-text">{legend.text.lv || 'Teksts nav norādīts.'}</div></section><section class="text-panel" data-lang="de" lang="de" aria-labelledby="de-heading"><h2 id="de-heading">DEUTSCH</h2><div class="legend-text">{legend.text.de || 'Text nicht angegeben.'}</div></section></div>
        <details class="information" data-information open><summary><span>Informācija<small>Par teiku un tās avotiem</small></span><i data-lucide="chevron-down"></i></summary><div class="information-body"><dl>{basicRows.map(([label,value]) => <div class="metadata-row"><dt>{label}</dt><dd>{value}</dd></div>)}</dl><details class="more-metadata"><summary><span>Papildu metadati</span><i data-lucide="chevron-down"></i></summary><dl><div class="metadata-row"><dt>Sējums</dt><dd>{legend.volume}. sējums</dd></div><div class="metadata-row"><dt>Tēma</dt><dd>{legend.chapter.lv || 'Nav norādīts'}{legend.chapter.de && <small lang="de"><br />{legend.chapter.de}</small>}</dd></div>{legend.originalMetadata && <div class="metadata-row"><dt>Oriģinālie metadati</dt><dd>{legend.originalMetadata}</dd></div>}{hasSources && <div class="metadata-row"><dt>Avoti</dt><dd>{allSources.length ? <ul class="source-list">{allSources.map(({source,relation}) => <li>{source.url ? <a href={source.url} target="_blank" rel="noopener noreferrer">{sourceLabel(source)}</a> : sourceLabel(source)}{relation.rawCitation && <small><br />{relation.rawCitation}</small>}</li>)}</ul> : (legend.primarySourceRaw || legend.secondarySourceRaw)}</dd></div>}</dl></details></div></details>
        {(legend.comments || legend.notes) && <aside class="editorial" aria-label="Redakcionālā informācija">{legend.comments && <details><summary>Redaktora komentārs</summary><p>{legend.comments}</p></details>}{legend.notes && <details><summary>Redakcionālās piezīmes</summary><p>{legend.notes}</p></details>}</aside>}
        <nav class="prev-next" aria-label="Blakus teikas">{previous ? <a href={`/teikas/${previous.id}/`}><span class="nav-direction"><i data-lucide="arrow-left"></i> Iepriekšējā teika</span><strong>{previous.title.lv || previous.id}</strong></a> : <span></span>}{next && <a href={`/teikas/${next.id}/`}><span class="nav-direction">Nākamā teika <i data-lucide="arrow-right"></i></span><strong>{next.title.lv || next.id}</strong></a>}</nav>
      </div>
    </div>
  </article>
  <script>
    const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-mode]')],panels=[...document.querySelectorAll<HTMLElement>('[data-lang]')],titles=[...document.querySelectorAll<HTMLElement>('[data-title-lang]')],texts=document.querySelector<HTMLElement>('[data-texts]')!;
    let currentMode=document.documentElement.dataset.contentMode||'parallel';
    function setMode(mode:string){currentMode=mode;tabs.forEach(t=>t.setAttribute('aria-selected',String(t.dataset.mode===mode)));panels.forEach(p=>p.hidden=mode!=='parallel'&&p.dataset.lang!==mode);titles.forEach(t=>t.hidden=mode!=='parallel'&&t.dataset.titleLang!==mode);texts.classList.toggle('single',mode!=='parallel')}
    tabs.forEach(t=>{t.addEventListener('click',()=>setMode(t.dataset.mode!));t.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const i=tabs.indexOf(t);tabs[(i+(e.key==='ArrowRight'?1:-1)+tabs.length)%tabs.length].focus()}})});setMode(document.documentElement.dataset.contentMode||'parallel');
    window.addEventListener('content-mode-change',(event)=>setMode((event as CustomEvent).detail));
    document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click',async(e)=>{const b=e.currentTarget as HTMLButtonElement,text=currentMode==='lv'?b.dataset.copyLv:currentMode==='de'?b.dataset.copyDe:b.dataset.copyParallel,tr=(key:string)=>(window as any).teikasT?.(key)||key;try{await navigator.clipboard.writeText(text||'')}catch{const area=document.createElement('textarea');area.value=text||'';area.style.position='fixed';area.style.opacity='0';document.body.append(area);area.select();document.execCommand('copy');area.remove()}const icon=b.querySelector<HTMLElement>('[data-lucide]')!;b.classList.add('copied');b.setAttribute('aria-label',tr('detail.copied'));icon.dataset.lucide='check';(window as any).renderLucideIcons?.();setTimeout(()=>{b.classList.remove('copied');b.setAttribute('aria-label',tr('detail.copy'));b.querySelector<HTMLElement>('[data-lucide]')!.dataset.lucide='copy';(window as any).renderLucideIcons?.()},1800)});
    document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click',e=>{if(document.referrer.startsWith(location.origin)){e.preventDefault();history.back()}});
    const info=document.querySelector<HTMLDetailsElement>('[data-information]')!,mobile=matchMedia('(max-width: 850px)');const arrangeInfo=(event:MediaQueryList|MediaQueryListEvent)=>{info.open=!event.matches};arrangeInfo(mobile);mobile.addEventListener('change',arrangeInfo);
  </script>
</BaseLayout>

---
import ui from '../i18n/ui.json';
const copy = (key: string) => (ui as Record<string, {lv: string}>)[`guide.${key}`].lv;
const chapters = [
  { id: 'dati', topics: ['corpus', 'limits', 'metadata'] },
  { id: 'karte', topics: ['mapViews', 'coordinates'] },
  { id: 'tikls', topics: ['overview', 'connections', 'scope', 'layouts'] },
  { id: 'atlase', topics: ['selection', 'exports'] },
];
---
<section class="platform-guide" id="platform-guide" aria-labelledby="platform-guide-title">
  <header class="guide-heading">
    <h2 id="platform-guide-title" data-i18n="guide.title">{copy('title')}</h2>
    <p data-i18n="guide.intro">{copy('intro')}</p>
  </header>
  <nav class="guide-contents" aria-labelledby="platform-guide-title">
    <ol>{chapters.map(chapter => <li><a href={`#${chapter.id}`} data-i18n={`guide.${chapter.id}`}>{copy(chapter.id)}</a></li>)}</ol>
  </nav>
  {chapters.map(chapter => <section class="guide-chapter" id={chapter.id} aria-labelledby={`guide-${chapter.id}`}>
    <h3 id={`guide-${chapter.id}`} data-i18n={`guide.${chapter.id}`}>{copy(chapter.id)}</h3>
    <div class="guide-topics">{chapter.topics.map(topic => <section class="guide-topic">
      <h4 data-i18n={`guide.${topic}Title`}>{copy(`${topic}Title`)}</h4>
      <p data-i18n={`guide.${topic}Text`}>{copy(`${topic}Text`)}</p>
    </section>)}</div>
  </section>)}
  <div class="guide-resources">
    <section>
      <h3 data-i18n="guide.openTitle">{copy('openTitle')}</h3>
      <p data-i18n="guide.openText">{copy('openText')}</p>
      <a href="https://github.com/UL-DHC/teikas" target="_blank" rel="noopener noreferrer" data-i18n="guide.openLink">{copy('openLink')}</a>
    </section>
    <section>
      <h3 data-i18n="guide.relatedTitle">{copy('relatedTitle')}</h3>
      <p data-i18n="guide.relatedText">{copy('relatedText')}</p>
      <a href="https://ul-dhc.github.io/norwegian-folk-legends/" target="_blank" rel="noopener noreferrer">Norwegian folk legends ↗</a>
    </section>
  </div>
</section>
<style>
  .platform-guide{margin-top:clamp(3rem,6vw,5rem);padding:clamp(1.4rem,4vw,3rem);border:1px solid var(--line);border-radius:20px;background:var(--raised);color:var(--ink)}
  .guide-heading{max-width:760px}.guide-heading h2{margin:0 0 1rem;font:500 clamp(1.8rem,3vw,2.4rem)/1.2 var(--serif)}
  .platform-guide p{font:1rem/1.8 var(--sans);color:var(--muted);margin:.6rem 0 0}
  .guide-contents{margin-top:1.8rem;padding:1.2rem 0;border-block:1px solid var(--line)}
  .guide-contents ol{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem 1.8rem;list-style:decimal-leading-zero;margin:0;padding-left:1.7rem}
  .guide-contents li{padding-left:.2rem;font-size:.9rem;color:var(--muted)}
  .platform-guide a{color:var(--blue);text-underline-offset:.22em}.platform-guide a:hover{text-decoration-thickness:2px}
  .guide-chapter{padding:2rem 0;border-bottom:1px solid var(--line);scroll-margin-top:2rem}
  .guide-chapter h3,.guide-resources h3{font:500 1.65rem/1.3 var(--serif);margin:0 0 1.2rem}
  .guide-chapter:target h3{color:var(--blue)}
  .guide-topics{max-width:780px}.guide-topic+.guide-topic{margin-top:1.6rem}.guide-topic h4{font:650 1.05rem/1.4 var(--sans);margin:0}
  .guide-resources{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;padding-top:2rem}.guide-resources a{display:inline-block;margin-top:1rem;font-size:.95rem}
  @media(max-width:760px){.guide-contents ol{grid-template-columns:1fr 1fr}.guide-resources{grid-template-columns:1fr;gap:2rem}}
  @media(max-width:420px){.guide-contents ol{grid-template-columns:1fr}.platform-guide{padding:1.25rem}}
</style>

---
import { Eclipse, Moon, Flame, Trees, LineSquiggle, House, Shovel, Waves } from 'lucide';
import { legends, collectorsById, narratorsById, displayPersonName } from '../lib/data';
import { homeTopics, matchesHomeTopic } from '../lib/home-topics';
import '../styles/home-topics.css';
const icons = { Eclipse, Moon, Flame, Trees, LineSquiggle, House, Shovel, Waves };
const topics = homeTopics.map(topic => {
  const records = legends.filter(record => matchesHomeTopic(record, topic));
  const collectorCount = new Set(records.filter(record => displayPersonName(collectorsById.get(record.collectorId))).map(record => record.collectorId)).size;
  const narratorCount = new Set(records.filter(record => record.narratorId && displayPersonName(narratorsById.get(record.narratorId))).map(record => record.narratorId)).size;
  return {...topic, count: records.length, collectorCount, narratorCount};
});
---
<section class="section shell home-topics" aria-labelledby="topics-title" data-i18n-skip>
  <div class="topics-heading">
    <h2 id="topics-title" data-topic-copy data-lv="Tēmas teiku krājumā" data-de="Themen der Sammlung" data-en="Themes in the Collection">Tēmas teiku krājumā</h2>
    <a class="icon-link topics-all" href={`${import.meta.env.BASE_URL}temas/`}><span data-topic-copy data-lv="Visas tēmas" data-de="Alle Themen" data-en="All Themes">Visas tēmas</span><i data-lucide="arrow-right" aria-hidden="true"></i></a>
  </div>
  <div class="topic-blocks">{topics.map(topic => <a class="topic-block" href={`${import.meta.env.BASE_URL}teksti/?topic=${topic.id}`} data-topic-id={topic.id}>
    <svg class="topic-symbol" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{icons[topic.icon as keyof typeof icons].map(([Tag, attributes]) => <Tag {...attributes} />)}</svg>
    <h3 data-topic-copy data-lv={topic.lv} data-de={topic.de} data-en={topic.en}>{topic.lv}</h3>
    <div class="topic-totals">
      <span><strong>{topic.count}</strong><span data-topic-copy data-lv="teikas" data-de="Sagen" data-en="legends">teikas</span></span>
      <span><strong>{topic.collectorCount}</strong><span data-topic-copy data-lv="pierakstītāji" data-de="Sammler" data-en="collectors">pierakstītāji</span></span>
      <span><strong>{topic.narratorCount}</strong><span data-topic-copy data-lv="teicēji" data-de="Erzähler" data-en="narrators">teicēji</span></span>
    </div>
  </a>)}</div>
</section>
<script>
  const syncTopics = () => {
    const lang = document.documentElement.dataset.uiLang || 'lv';
    document.querySelectorAll<HTMLElement>('[data-topic-copy]').forEach(element => {
      element.textContent = element.dataset[lang] || element.dataset.lv || '';
    });
  };
  syncTopics();
  window.addEventListener('ui-language-change', syncTopics);
  const motion = matchMedia('(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference)');
  document.querySelectorAll<HTMLAnchorElement>('.topic-block').forEach(card => {
    card.addEventListener('pointermove', event => {
      if (!motion.matches) return;
      const bounds = card.getBoundingClientRect();
      card.style.setProperty('--topic-x', `${(event.clientX-bounds.left)/bounds.width*100}%`);
      card.style.setProperty('--topic-y', `${(event.clientY-bounds.top)/bounds.height*100}%`);
    }, {passive:true});
  });
</script>
